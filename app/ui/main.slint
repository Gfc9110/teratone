import { VelocityLane, VelocityVisual } from "velocity_lane.slint";
import { TrackStatus } from "track_widgets.slint";
export { VelocityVisual } from "velocity_lane.slint";
import { Button, ComboBox, SpinBox, Slider, CheckBox, LineEdit, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { StudioTheme } from "studio_theme.slint";
import { StudioIconButton } from "studio_controls.slint";

export struct MiniVisual { x: float, y: float, w: float, h: float }
export struct ClipVisual { id: string, name: string, start: float, length: float, selected: bool, notes: [MiniVisual] }
export struct TrackVisual {
    id: string, name: string, tint: color, instrument: string, selected: bool,
    mute: bool, solo: bool, audible: bool, clips: [ClipVisual],
}
export struct PadVisual {id:string,name:string,midi:int,filled:bool,muted:bool}
export struct KeyVisual { pitch: int, y: float, h: float, black: bool, c: bool, label: string, in-scale: bool }
export struct NoteVisual { x: float, y: float, w: float, h: float, selected: bool, label: string }
export struct ReferenceVisual { track-id: string, clip-id: string, label: string, visible: bool, pinned: bool, active: bool }
export struct GhostVisual { x: float, y: float, w: float, h: float, tint: color }
export struct RecentProjectVisual { name: string, path: string, available: bool }

// A compact tempo control with fixed geometry across all supported values.
component TempoControl inherits Rectangle {
    in-out property <int> value: 120;
    callback edited(int);
    min-width: 104px; max-width: 104px; preferred-width: 104px;
    min-height: 30px; max-height: 30px; preferred-height: 30px;
    horizontal-stretch: 0; vertical-stretch: 0;
    forward-focus: input;
    background: StudioTheme.raised; border-color: StudioTheme.border; border-width: 1px; border-radius: 5px;
    accessible-role: spinbox; accessible-label: "Tempo in BPM";
    accessible-value: root.value; accessible-value-minimum: 30; accessible-value-maximum: 300; accessible-value-step: 1;
    accessible-action-increment => { root.change-value(root.value + 1); }
    accessible-action-decrement => { root.change-value(root.value - 1); }
    accessible-action-set-value(v) => { if v.is-float() { root.change-value(v.to-float()); } }
    function change-value(v: int) {
        if v >= 30 && v <= 300 && v != root.value { root.value = v; root.edited(v); }
    }
    changed value => { input.text = root.value; }
    TouchArea {
        scroll-event(event) => {
            if event.delta-y > 0px { root.change-value(root.value + 1); return accept; }
            if event.delta-y < 0px { root.change-value(root.value - 1); return accept; }
            reject
        }
    }
    Rectangle {
        x: 0px; width: 28px; height: parent.height;
        Text { text: "▾"; font-size: 20px; color: root.value > 30 ? #d9e6f2 : #738290; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { enabled: root.value > 30; mouse-cursor: pointer; clicked => { root.change-value(root.value - 1); } }
    }
    input := TextInput {
        x: 28px; width: 48px; height: parent.height; text: root.value;
        color: #e8f2ff; horizontal-alignment: center; vertical-alignment: center;
        accessible-role: none;
        edited => { if self.text.is-float() { root.change-value(self.text.to-float()); } }
        accepted => { self.text = root.value; }
        changed has-focus => { if !self.has-focus { self.text = root.value; } }
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.change-value(root.value + 1); return accept; }
            if event.text == Key.DownArrow { root.change-value(root.value - 1); return accept; }
            reject
        }
    }
    Rectangle {
        x: 76px; width: 28px; height: parent.height;
        Text { text: "▴"; font-size: 20px; color: root.value < 300 ? #d9e6f2 : #738290; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { enabled: root.value < 300; mouse-cursor: pointer; clicked => { root.change-value(root.value + 1); } }
    }
}
export component AppWindow inherits Window {
    in property <int> track-limit;
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: root.home-visible ? "OpenDAW — Projects" : "OpenDAW — " + root.project-name + (root.dirty ? " *" : "");
    preferred-width: 1280px; preferred-height: 820px; min-width: 1000px; min-height: 760px;
    background: StudioTheme.app; default-font-family: "sans-serif"; default-font-size: 13px;
    in property <string> project-name: "First session";
    // Last controller session presented by the UI, used to reject stale scrolls.
    in property <string> ui-project-session: "0";
    in property <string> status: "Starting application controller…";
    in property <string> action-error;
    in property <int> pending-actions;
    in property <string> mix-label: "Ready on Play";
    in property <string> selected-label;
    in property <string> transport-text: "001 : 01";
    in property <[TrackVisual]> track-items;
    in property <string> track-id: "1";
    in property <string> arrangement-track-id: "1";
    in property <string> inspector-track-id: "1";
    in property <int> inspector-track-index: 0;
    in property <string> inspector-track-name: "Sine lead";
    in-out property <string> inspector-track-name-draft: "Sine lead";
    in-out property <int> inspector-color-index: 0;
    in-out property <float> inspector-gain: 0.7;
    in-out property <float> inspector-pan: 0;
    in property <bool> inspector-muted;
    in property <bool> inspector-soloed;
    in property <bool> inspector-audible: true;
    in property <string> inspector-instrument: "Sine oscillator";
    in property <bool> inspector-is-synth: true;
    in property <bool> inspector-is-drums;
    in-out property <string> inspector-sample-path;
    in-out property <int> inspector-sample-root: 60;
    in-out property <bool> inspector-sample-one-shot: false;
    in property <string> track-name: "Sine lead";
    in-out property <string> track-name-draft: "Sine lead";
    in property <string> instrument: "Sine oscillator";
    in property <bool> is-drums;
    in property <string> drum-kit-name;
    in property <[PadVisual]> drum-pads;
    in property <[bool]> pad-pulses;
    in property <[bool]> pad-mutes;
    in property <string> pad-id: "0";
    in-out property <string> pad-name;
    in property <string> pad-source;
    in property <bool> pad-filled;
    in-out property <string> pad-import-path;
    in-out property <int> pad-midi: 35;
    in-out property <int> pad-preview-velocity: 100;
    in-out property <float> pad-gain: 1;
    in-out property <float> pad-pan: 0;
    in-out property <int> pad-tune: 0;
    in-out property <int> pad-choke: 0;
    in property <bool> pad-muted;
    in property <bool> pad-one-shot: true;
    in property <bool> is-synth: true;
    in-out property <bool> sound-tab: false;
    in-out property <int> synth-wave: 0;
    in-out property <float> synth-shape: 1;
    in-out property <float> synth-duty: 0.5;
    in-out property <int> synth-attack: 6;
    in-out property <int> synth-decay: 60;
    in-out property <int> synth-sustain: 75;
    in-out property <int> synth-release: 60;
    in property <string> preset-label: "Legacy Sine";
    in-out property <int> factory-index: 0;
    in-out property <string> preset-name: "My sound";
    in-out property <string> preset-path: "My-sound.synth.json";
    in-out property <length> inspector-scroll: 0px;
    in-out property <string> sample-path;
    in-out property <int> sample-root: 60;
    in-out property <bool> sample-one-shot: false;
    in-out property <int> color-index: 0;
    in property <[string]> clip-names;
    in property <[string]> clip-ids;
    in-out property <int> clip-index: 0;
    in property <float> clip-start-beat: 0;
    in property <int> track-index: 0;
    in-out property <int> bpm: 120;
    in-out property <float> gain: 0.7;
    in-out property <float> pan: 0;
    in property <bool> muted;
    in property <bool> soloed;
    in property <bool> audible: true;
    in property <bool> dirty;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> silent-mode;
    in property <bool> playing;
    in property <bool> looping;
    in property <bool> export-busy;
    in property <float> peak-left;
    in property <float> peak-right;
    private property <float> playhead-x: (root.project-position - root.clip-start-beat - root.display-scroll-beat)*root.pixels-per-beat;
    in property <float> project-position;
    in property <float> pixels-per-beat: 64;
    in property <float> scroll-beat;
    in property <float> piano-scroll-y;
    in property <float> piano-row-height: 16;
    in property <[KeyVisual]> key-items;
    in property <string> instance-id;
    in property <string> selected-note-id: "0";
    in-out property <int> note-velocity: 100;
    in-out property <int> notation-index: 1;
    in-out property <length> piano-bar-y;
    in-out property <length> piano-bar-x;
    // Locally project the last rendered scene onto the current scrollbar
    // position while the worker catches up with high-resolution wheel input.
    private property <float> display-scroll-beat: -root.piano-bar-x / 1px / root.pixels-per-beat;
    private property <length> piano-scene-offset-x: root.piano-bar-x + root.scroll-beat * root.pixels-per-beat * 1px;
    private property <length> piano-scene-offset-y: root.piano-bar-y + root.piano-scroll-y * 1px;
    out property <float> piano-projection-x: root.piano-scene-offset-x / 1px;
    out property <float> piano-projection-y: root.piano-scene-offset-y / 1px;
    out property <float> piano-display-beat: root.display-scroll-beat;
    in property <string> clip-id: "0";
    in property <float> clip-length-beats;
    in-out property <string> clip-name-draft;
    private property <length> keyboard-width: root.is-drums ? 140px : 58px;
    private property <int> piano-first-beat: floor(root.display-scroll-beat);
    private property <int> piano-beat-count: ceil(root.canvas-width/root.pixels-per-beat)+2;
    private property <int> piano-first-line: floor(root.display-scroll-beat*4);
    in property <[NoteVisual]> note-items;
    in property <[ReferenceVisual]> reference-items;
    in property <int> reference-count;
    in property <[GhostVisual]> ghost-items;
    in property <bool> follow-selection: true;
    in property <int> midi-view-mode: 0;
    in property <int> piano-row-count: 128;
    in property <int> scale-mode: 0;
    in property <int> scale-root: 0;
    in property <int> snap-index: 2;
    in property <bool> navigation-linked: false;
    in-out property <int> ui-density: 0;
    in property <[VelocityVisual]> velocity-items;
    in-out property <bool> velocity-visible: false;
    in-out property <int> inspector-detail: 0;
    in property <float> project-beats: 16;
    in property <bool> arrangement-limited;
    in-out property <bool> inspector-visible: false;
    in-out property <bool> inspector-pinned: true;
    in-out property <float> inspector-custom-width: 240;
    in-out property <bool> project-tab: false;
    in-out property <bool> confirm-close: false;
    in-out property <bool> about-visible: false;
    in property <string> project-path;
    in property <bool> folder-dialog-busy;
    in-out property <bool> home-visible;
    in property <bool> has-project;
    in property <[RecentProjectVisual]> recent-projects;
    in-out property <string> new-name: "Untitled";
    in-out property <string> new-parent;
    in-out property <bool> save-as-visible;
    in-out property <string> save-as-name;
    in-out property <string> save-as-parent;
    in-out property <bool> confirm-switch;
    private property <int> pending-project-kind;
    private property <string> pending-project-path;
    private property <string> pending-project-name;
    in-out property <string> export-path: "First-session.wav";
    in-out property <float> arrangement-zoom: 48;
    in-out property <length> arrangement-x: 0px;
    in-out property <length> arrangement-y: 0px;
    // Compact workspace sizing and UI-only layout state.
    private property <length> header-width: 190px;
    private property <length> row-height: root.ui-density == 2 ? 64px : root.ui-density == 1 ? 58px : 48px;
    private property <length> toolbar-height: root.ui-density == 2 ? 44px : 30px;
    private property <length> editor-toolbar-height: root.ui-density == 2 ? 44px : 30px;
    private property <length> velocity-control-width: 128px;
    private property <length> velocity-control-height: 32px;
    private property <length> splitter-height: 12px;
    in-out property <int> workspace-focus: 0;
    in-out property <float> workspace-split: -1;
    private property <length> max-arrangement-height: max(100px, main.height - (root.velocity-visible ? 325px : 265px) - root.toolbar-height - root.editor-toolbar-height + 60px);
    private property <length> adaptive-arrangement-height: min(root.max-arrangement-height, max(100px, (root.track-items.length * root.row-height) + 4px));
    private property <int> arrangement-first-beat: max(0, floor(-root.arrangement-x / 1px / root.arrangement-zoom));
    private property <int> arrangement-beat-count: ceil(root.lane-width / root.arrangement-zoom) + 2;
    private property <length> inspector-width: root.inspector-visible ? max(220,min(400,root.inspector-custom-width))*1px : 0px;
    // Keep the user's requested width and pin state, but let a wide inspector
    // overlay the workspace when reserving it would clip the editor toolbar.
    private property <bool> inspector-overlaid: root.inspector-visible && (!root.inspector-pinned || root.width < 1000px || root.width - root.inspector-width < 774px);
    private property <length> reserved-inspector-width: root.inspector-visible && !root.inspector-overlaid ? root.inspector-width : 0px;
    private property <length> arrangement-height: root.workspace-focus == 1 ? max(100px, main.height - root.toolbar-height - root.editor-toolbar-height - 60px) : root.workspace-focus == 2 ? 100px : root.workspace-split < 0 ? root.adaptive-arrangement-height : max(100px, min(root.max-arrangement-height, root.workspace-split * root.max-arrangement-height));
    private property <string> drag-id;
    private property <string> renaming-track-id;
    private property <string> inline-track-name;
    in-out property <string> focused-track-id;
    private property <bool> dragging;
    private property <int> drag-index: -1;
    private property <float> drag-start;
    private property <float> drag-pointer;
    private property <int> drop-index: -1;
    out property <float> splitter-x: split-touch.absolute-position.x / 1px + split-touch.width / 2px;
    out property <float> tempo-control-x: tempo-control.absolute-position.x / 1px;
