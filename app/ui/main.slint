    callback exit-confirmed();
    public function show-projects() {
        if !root.export-busy { root.cancel-interactions(); root.stop(); root.home-visible = true; }
    }
    public function request-switch(kind: int, path: string, name: string) {
        root.cancel-interactions();
        if root.dirty || root.pending-actions > 0 {
            root.pending-project-kind = kind; root.pending-project-path = path; root.pending-project-name = name;
            root.confirm-switch = true;
        } else { root.switch-project(kind, path, name, 0); }
    }
    public function request-save() {
        if root.project-path == "" {
            root.save-as-name = root.project-name; root.save-as-parent = root.new-parent; root.save-as-visible = true;
        } else { root.save-project(root.project-path); }
    }
    public function show-save-as() {
        root.cancel-interactions(); root.save-as-name = root.project-name + " copy";
        root.save-as-parent = root.new-parent; root.save-as-visible = true;
    }
    private property <string> clip-drag-id;
    private property <string> clip-drag-track;
    private property <float> clip-press-beat;
    private property <float> clip-press-y;
    private property <float> clip-pointer-x;
    private property <float> clip-pointer-y;
    private property <float> clip-base-start;
    private property <float> clip-base-length;
    private property <float> clip-preview-start;
    private property <float> clip-preview-length;
    private property <int> clip-target-index;
    private property <bool> clip-resizing;
    private property <bool> clip-dragging;
    public function piano-wheel(dx:float,dy:float) {
        root.piano-bar-y=min(0px,max(min(0px,root.canvas-height*1px - 128*root.piano-row-height*1px),root.piano-bar-y+dy*1px));
        root.piano-bar-x=min(0px,max(min(0px,root.canvas-width*1px - root.clip-length-beats*root.pixels-per-beat*1px),root.piano-bar-x+dx*1px));
        root.scroll-piano(-root.piano-bar-x/1px/root.pixels-per-beat,-root.piano-bar-y/1px);
    }
    public function cancel-interactions() {
        root.clip-drag-id="";root.clip-dragging=false;root.drag-id="";root.dragging=false;root.drop-index=-1;
        root.release-audition();root.cancel-note();
    }
    public function update-clip-drag() {
        if root.clip-drag-id!="" {
            let beat=(root.clip-pointer-x - root.rows-x - root.header-size - root.arrangement-x/1px)/root.arrangement-zoom;
            let delta=round((beat - root.clip-press-beat)*4)/4;
            if abs(delta)>0 || abs(root.clip-pointer-y - root.clip-press-y)>5 {root.clip-dragging=true;}
            if root.clip-resizing {root.clip-preview-length=max(0.25,root.clip-base-length+delta);}
            else {
                root.clip-preview-start=max(0,root.clip-base-start+delta);
                root.clip-target-index=max(0,min(root.track-items.length - 1,floor((root.clip-pointer-y - root.rows-y - root.arrangement-y/1px)/root.row-size)));
            }
        }
    }
    public function reveal-clip() {
        let start=root.clip-start-beat*root.arrangement-zoom*1px+root.arrangement-x;
        let end=start+root.clip-length-beats*root.arrangement-zoom*1px;
        if root.clip-id!="0" && min(end,root.lane-width*1px) - max(start,0px)<min(100px,root.clip-length-beats*root.arrangement-zoom*1px) {
            root.arrangement-x=-max(0,root.clip-start-beat - 1)*root.arrangement-zoom*1px;root.clamp-scroll();
        }
    }
    public function reveal-selected() {
        root.arrangement-y = min(0px, max(min(0px, rows.visible-height - rows.content-height),
            max(-root.track-index * root.row-height, min(root.arrangement-y, rows.visible-height - (root.track-index + 1) * root.row-height))));
    }
    public function tick-drag() {
        if root.clip-drag-id!="" && root.clip-dragging {
            if root.clip-pointer-y<root.rows-y+24 {root.arrangement-y=min(0px,root.arrangement-y+8px);}
            if root.clip-pointer-y>root.rows-y+root.rows-height - 24 {root.arrangement-y=max(min(0px,rows.visible-height - rows.content-height),root.arrangement-y - 8px);}
            if root.clip-pointer-x<root.rows-x+root.header-size+24 {root.arrangement-x=min(0px,root.arrangement-x+8px);}
            if root.clip-pointer-x>root.rows-x+root.header-size+root.lane-width - 24 {root.arrangement-x=max(min(0px,horizontal.visible-width - horizontal.content-width),root.arrangement-x - 8px);}
            root.update-clip-drag();
        }
        if root.drag-id != "" && root.dragging {
            if root.drag-pointer < root.rows-y + 24 { root.arrangement-y = min(0px, root.arrangement-y + 8px); }
            if root.drag-pointer > root.rows-y + root.rows-height - 24 {
                root.arrangement-y = max(min(0px, rows.visible-height - rows.content-height), root.arrangement-y - 8px);
            }
            root.drop-index = max(0, min(root.track-items.length - 1, floor((root.drag-pointer - root.rows-y - root.arrangement-y / 1px) / root.row-size)));
        }
    }
    public function clamp-scroll() {
        root.arrangement-y = min(0px, max(min(0px, rows.visible-height - rows.content-height), root.arrangement-y));
        root.arrangement-x = min(0px, max(min(0px, horizontal.visible-width - horizontal.content-width), root.arrangement-x));
    }
    MenuBar {
        Menu { title: "File";
            MenuItem { title: "New project / Recent projects…"; enabled: !root.export-busy; activated => { root.show-projects(); } }
            MenuItem { title: "Open project…"; enabled: !root.export-busy; activated => { root.choose-open-project(); } }
            MenuItem { title: "Save"; enabled: root.has-project; activated => { root.request-save(); } }
            MenuItem { title: "Save as…"; enabled: root.has-project; activated => { root.show-save-as(); } }
            MenuItem { title: "Open project folder"; enabled: root.project-path != ""; activated => { root.reveal-project(); } }
        }
        Menu { title: "Help"; MenuItem { title: "About OpenDAW"; activated => { root.about-visible = true; } } }
    }
    Rectangle {
        x: 0; y: 0; height: 64px; width: parent.width; background: #151d28;
        Text { x: 16px; y: 10px; text: "OPENDAW"; color: #79e3bf; font-size: 23px; font-weight: 700; }
        Text { x: 18px; y: 39px; text: "ARRANGEMENT / TRACK MIXER"; color: #8394aa; font-size: 9px; }
        HorizontalLayout {
            x: 232px; y: 15px; width: parent.width - 500px; height: 34px; spacing: 6px;
            play-button := Button { text: root.playing ? "Playing" : "Play"; clicked => { root.play(); } }
            Button { text: "Pause"; clicked => { root.pause(); } }
            Button { text: "Stop"; clicked => { root.stop(); } }
            Button { text: root.looping ? "Loop on" : "Loop off"; clicked => { root.toggle-loop(); } }
            Button { text: "Projects"; enabled: !root.export-busy; clicked => { root.show-projects(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { x: parent.width - 230px; y: 11px; width: 210px; height: 36px; text: root.transport-text;
            font-size: 25px; color: #e8f2ff; horizontal-alignment: right; }
    }
    main := Rectangle {
        x: 12px; y: 74px; width: root.width - root.inspector-width - 32px; height: root.height - 124px;
        HorizontalLayout {
            x: 0; y: 0; width: parent.width; height: 30px; spacing: 5px;
            Text { text: "TRACKS  " + root.track-items.length + " / " + root.track-limit; color: #a6bdd4; vertical-alignment: center; }
            add-track-button := Button { text: "+ Track"; enabled: root.track-items.length < root.track-limit; clicked => { root.add-track(root.track-id); } }
            add-drums-button := Button {text:"+ Drums";enabled:root.track-items.length<root.track-limit;clicked=>{root.add-drums(root.track-id);root.sound-tab=true;root.project-tab=false;root.inspector-scroll=0px;}}
            duplicate-button := Button { text: "Duplicate"; enabled: root.track-items.length < root.track-limit; clicked => { root.duplicate-track(root.track-id); } }
            Button { text: root.width < 1100px ? "Show" : "Show selected";accessible-label:"Show selected track"; clicked => { root.reveal-selected(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "−"; clicked => { root.arrangement-zoom = max(12, root.arrangement-zoom * 0.8); root.clamp-scroll(); } }
            Button { text: "+"; clicked => { root.arrangement-zoom = min(192, root.arrangement-zoom * 1.25); } }
            inspector-toggle := Button { text: root.inspector-visible ? "Inspector ›" : "‹ Inspector"; clicked => { root.inspector-visible = !root.inspector-visible; } }
        }
        Rectangle {
            x: 0; y: 38px; width: parent.width; height: 26px; background: #1a2633;
            Text { x: 12px; y: 5px; text: "TRACK / INSTRUMENT"; color: #91a7bf; font-size: 10px; }
            Rectangle {
                x: root.header-width; y: 0; width: parent.width - self.x; height: parent.height; clip: true;
                for beat in root.arrangement-beat-count : Text {
                    x: ((beat + root.arrangement-first-beat) * root.arrangement-zoom) * 1px + root.arrangement-x + 4px; y: 4px;
                    text: Math.mod(beat + root.arrangement-first-beat, 4) == 0 ? (floor((beat + root.arrangement-first-beat) / 4) + 1) + ".1" : "·";
                    color: #a6b9cf; font-size: 10px;
                }
                TouchArea { clicked => { root.seek-project((self.mouse-x - root.arrangement-x) / 1px / root.arrangement-zoom); } }
            }
        }
        clip-focus := FocusScope {
            x:0;y:64px;width:parent.width;height:root.arrangement-height;
            focus-lost(reason) => {root.cancel-interactions();}
        rows := ScrollView {
            x: 0; y: 0; width: parent.width; height: parent.height;
            content-width: self.visible-width; content-height: max(self.visible-height, root.track-items.length * root.row-height);
            content-y <=> root.arrangement-y;
            horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-on;
            for track[index] in root.track-items : Rectangle {
                x: 0; y: index * root.row-height; width: rows.visible-width; height: root.row-height;
                background: track.selected ? #22354a : #141e2b;
                header := Rectangle {
                    x: 0; y: 0; width: root.header-width; height: parent.height;
                    Rectangle { x: 0; y: 0; width: 4px; height: parent.height - 1px; background: track.tint; }
                    Text { x: 9px; y: 9px; text: "≡"; color: #829bb2; }
                    handle := TouchArea {
                        x: 4px; y: 0; width: 24px; height: parent.height;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                clip-focus.focus();root.drag-id = track.id; root.drag-index = index; root.drag-start = self.absolute-position.y / 1px + self.mouse-y / 1px;
                                root.drag-pointer = root.drag-start; root.dragging = false;
                            }
                            if event.kind == PointerEventKind.up && root.drag-id == track.id {
                                if root.dragging && root.drop-index >= 0 { root.reorder-track(track.id, root.drop-index); }
                                else { root.select-track(track.id); }
                                root.drag-id = ""; root.dragging = false; root.drop-index = -1;
                            }
                            if event.kind == PointerEventKind.cancel { root.drag-id = ""; root.dragging = false; root.drop-index = -1; }
                        }
                        moved => {
                            if self.pressed && root.drag-id == track.id {
                                root.drag-pointer = self.absolute-position.y / 1px + self.mouse-y / 1px;
                                if abs(root.drag-pointer - root.drag-start) > 4 { root.dragging = true; }
                                root.tick-drag();
                            }
                        }
                    }
                    Button {
                        x: 30px; y: 5px; width: root.header-width - 38px; height: 28px;
                        text: (track.selected ? "› " : "") + track.name;
                        clicked => { root.select-track(track.id); }
                    }
                    Text { x: 32px; y: 36px; width: 100px; height: 15px; text: track.instrument;
                        color: #a0b4cb; font-size: 10px; overflow: elide; }
                    Rectangle { x: 32px; y: 59px; width: 6px; height: 6px; border-radius: 3px; background: track.audible ? #78d9b7 : #697587; }
                    Text { x: 44px; y: 54px; text: track.audible ? "To Master" : track.mute ? "Muted" : "Solo excluded"; color: #839bb4; font-size: 9px; }
                    Button { x: 133px; y: 38px; width: 32px; height: 28px; text: "M"; accessible-checkable: true; accessible-checked: track.mute; checked: track.mute;
                        accessible-label: "Mute " + track.name; clicked => { root.toggle-mute(track.id); } }
                    Button { x: 169px; y: 38px; width: 32px; height: 28px; text: "S"; accessible-checkable: true; accessible-checked: track.solo; checked: track.solo;
                        accessible-label: "Solo " + track.name; clicked => { root.toggle-solo(track.id); } }
                }
                lane := Rectangle {
                    x: root.header-width; y: 0; width: parent.width - self.x; height: parent.height; clip: true;
                    background: track.selected ? #182a3b : #111b27;
                    for beat in root.arrangement-beat-count : Rectangle {
                        x: (beat + root.arrangement-first-beat) * root.arrangement-zoom * 1px + root.arrangement-x; y: 0; width: 1px; height: parent.height;
                        background: Math.mod(beat + root.arrangement-first-beat, 4) == 0 ? #314357 : #1d2b3b;
                    }
                    TouchArea {
                        clicked => { root.select-track(track.id); }
                        double-clicked => {root.new-clip(track.id,max(0,round((self.mouse-x - root.arrangement-x)/1px/root.arrangement-zoom*4)/4));}
                        scroll-event(event) => {
                            if event.delta-x != 0px { root.arrangement-x += event.delta-x; root.clamp-scroll(); return accept; }
                            reject
                        }
                    }
                    for clip in track.clips : Rectangle {
                        x: clip.start * root.arrangement-zoom * 1px + root.arrangement-x; y: 7px;
                        width: max(4px, clip.length * root.arrangement-zoom * 1px - 2px); height: parent.height - 14px;
                        opacity: root.clip-drag-id==clip.id && root.clip-dragging ? 0.35 : 1;
                        border-radius: 4px; background: track.audible ? track.tint.with-alpha(0.30) : track.tint.with-alpha(0.12);
                        border-width: clip.selected ? 2px : 1px; border-color: clip.selected ? #d8edee : track.tint.with-alpha(0.5);
                        Text { x: 8px; y: 5px; width: parent.width - 16px; height: 15px; text: clip.name; color: #d4e6ed; font-size: 11px; overflow: elide; }
                        Rectangle {
                            x: 5px; y: 26px; width: max(0px, parent.width - 10px); height: parent.height - 31px; clip: true;
                            for note in clip.notes : Rectangle {
                                x: note.x * parent.width; y: note.y * parent.height;
                                width: max(1px, note.w * parent.width - 1px); height: max(2px, note.h * parent.height);
                                background: track.audible ? track.tint : #6a7c88;
                            }
                        }
                        clip-touch := TouchArea {
                            mouse-cursor: self.mouse-x>self.width - 9px ? ew-resize : grab;
                            pointer-event(event) => {
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {
                                    clip-focus.focus();root.clip-drag-id=clip.id;root.clip-drag-track=track.id;
                                    root.clip-pointer-x=self.absolute-position.x/1px+self.mouse-x/1px;
                                    root.clip-pointer-y=self.absolute-position.y/1px+self.mouse-y/1px;
                                    root.clip-press-beat=(root.clip-pointer-x - root.rows-x - root.header-size - root.arrangement-x/1px)/root.arrangement-zoom;
                                    root.clip-press-y=root.clip-pointer-y;root.clip-base-start=clip.start;root.clip-base-length=clip.length;
                                    root.clip-preview-start=clip.start;root.clip-preview-length=clip.length;
                                    root.clip-target-index=index;root.clip-resizing=self.mouse-x>self.width - 9px;root.clip-dragging=false;
                                }
                                if event.kind==PointerEventKind.up && root.clip-drag-id==clip.id {
                                    if root.clip-dragging {
                                        if root.clip-resizing {root.resize-clip(track.id,clip.id,root.clip-preview-length);}
                                        else {root.move-clip(track.id,clip.id,root.track-items[root.clip-target-index].id,root.clip-preview-start);}
                                    } else {root.select-clip(track.id,clip.id);}
                                    root.clip-drag-id="";root.clip-dragging=false;
                                }
                                if event.kind==PointerEventKind.cancel {root.clip-drag-id="";root.clip-dragging=false;}
                            }
                            moved => {
                                if self.pressed && root.clip-drag-id==clip.id {
                                    root.clip-pointer-x=self.absolute-position.x/1px+self.mouse-x/1px;
                                    root.clip-pointer-y=self.absolute-position.y/1px+self.mouse-y/1px;root.update-clip-drag();
                                }
                            }
                            Tooltip {text:@markdown("Drag to move · right edge to resize · snap 1/16");}
                            scroll-event(event) => {
                                if event.delta-x != 0px { root.arrangement-x += event.delta-x; root.clamp-scroll(); return accept; }
                                reject
                            }
                        }
                    }
                    if root.project-position * root.arrangement-zoom * 1px + root.arrangement-x >= 0px : Rectangle {
                        x: root.project-position * root.arrangement-zoom * 1px + root.arrangement-x; y: 0; width: 1px; height: parent.height; background: #edf8ff;
                    }
                }
                Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #324254; }
            }
            if root.clip-dragging : Rectangle {
                x:root.header-width;y:0;width:rows.visible-width - self.x;height:rows.content-height;clip:true;
                Rectangle {
                    x:root.clip-preview-start*root.arrangement-zoom*1px+root.arrangement-x;
                    y:root.clip-target-index*root.row-height+7px;
                    width:max(4px,root.clip-preview-length*root.arrangement-zoom*1px - 2px);height:root.row-height - 14px;
                    background:#79dfb94d;border-width:2px;border-color:#efffd8;border-radius:4px;
                    Text {x:6px;y:4px;text:root.clip-resizing ? "Resize · "+root.clip-preview-length+" beats" : "Move · beat "+(root.clip-preview-start+1);color:#efffd8;}
                }
            }
            if root.dragging && root.drop-index >= 0 : Rectangle {
                x: 0; y: (root.drop-index + (root.drop-index > root.drag-index ? 1 : 0)) * root.row-height; width: rows.visible-width; height: 3px; background: #ffe39b;
            }
        }
        }
        horizontal := ScrollView {
            x: root.header-width; y: 64px + root.arrangement-height; width: parent.width - self.x - 12px; height: 18px;
            min-height: 18px; content-width: max(self.visible-width, root.project-beats * root.arrangement-zoom * 1px);
            content-height: self.visible-height; content-x <=> root.arrangement-x;
            horizontal-scrollbar-policy: always-on; vertical-scrollbar-policy: always-off;
        }
        HorizontalLayout {
            x:0;y:86px+root.arrangement-height;width:parent.width;height:28px;spacing:5px;
            Text {text:"CLIPS";color:#95abc2;vertical-alignment:center;font-size:10px;}
            new-clip-button := Button {text:"+ Clip";clicked=>{root.new-clip(root.track-id,root.clip-id!="0" ? root.clip-start-beat+root.clip-length-beats : root.project-position);}}
            dup-clip-button := Button {text:"Duplicate";enabled:root.clip-id!="0";clicked=>{root.duplicate-clip(root.track-id,root.clip-id);}}
            remove-clip-button := Button {text:"Remove";enabled:root.clip-id!="0";clicked=>{root.remove-clip(root.track-id,root.clip-id);}}
            LineEdit {text<=>root.clip-name-draft;enabled:root.clip-id!="0";placeholder-text:"Clip name · Enter to apply";accepted=>{root.rename-clip(root.track-id,root.clip-id,self.text);}}
        }
        editor := Rectangle {
            x:0;y:122px+root.arrangement-height;width:parent.width;height:parent.height - self.y;
            HorizontalLayout {
                x:0;y:0;width:parent.width;height:28px;spacing:3px;
                undo-button := Button {text:"Undo";enabled:root.can-undo;clicked=>{root.undo();}}
                Button {text:"Redo";enabled:root.can-redo;clicked=>{root.redo();}}
                Button {text:"Delete note";enabled:root.selected-note-id!="0";clicked=>{root.remove-note();}}
                Rectangle {horizontal-stretch:1;}
                Button {text:"X−";clicked=>{root.zoom(0.8);}}
                Button {text:"X+";clicked=>{root.zoom(1.25);}}
                Button {text:"Y−";clicked=>{root.zoom-y(0.8);}}
                Button {text:"Y+";clicked=>{root.zoom-y(1.25);}}
                Button {text:"Fit notes";clicked=>{root.fit-notes();}}
                Button {text:"Oct−";clicked=>{root.pitch-view(-12);}}
                Button {text:"Oct+";clicked=>{root.pitch-view(12);}}
            }
            HorizontalLayout {
                x:0;y:33px;width:parent.width;height:26px;spacing:5px;
                Text {text:"CLIP";color:#a6bbd2;vertical-alignment:center;font-size:10px;}
                ComboBox {model:root.clip-names;current-index<=>root.clip-index;enabled:root.clip-id!="0";
                    selected(value)=>{if self.current-index>=0 && self.current-index<root.clip-ids.length {root.select-clip(root.track-id,root.clip-ids[self.current-index]);}}}
                Text {text:"Start "+(root.clip-start-beat+1)+" · "+root.clip-length-beats+" beats · 1/16";color:#8199b2;vertical-alignment:center;font-size:10px;}
                Rectangle {horizontal-stretch:1;}
                Text {text:root.is-drums ? "Drums / MIDI" : "Middle C";color:#a5bbcc;vertical-alignment:center;font-size:10px;}
                ComboBox {visible:!root.is-drums;width:76px;model:["C3","C4","C5"];current-index<=>root.notation-index;selected(value)=>{root.notation(self.current-index - 1);}}
            }
            Rectangle {x:0;y:64px;width:root.keyboard-width;height:20px;background:#243445;
                Text {text:root.is-drums ? "DRUMS / MIDI" : "KEY / MIDI";color:#a6bfca;font-size:9px;horizontal-alignment:center;vertical-alignment:center;}}
            Rectangle {
                x:root.keyboard-width;y:64px;width:parent.width - self.x - 12px;height:20px;background:#1a2532;clip:true;
                for beat in root.piano-beat-count : Text {
                    x:(beat+root.piano-first-beat - root.scroll-beat)*root.pixels-per-beat*1px+3px;y:3px;
                    text:beat+root.piano-first-beat+1;color:#a2b5cc;font-size:10px;
                }
                TouchArea {clicked=>{root.seek(root.scroll-beat+self.mouse-x/1px/root.pixels-per-beat);}}
            }
            piano-focus := FocusScope {
                x:0;y:85px;width:parent.width - 12px;height:max(160px,parent.height - 130px);
                focus-lost(reason)=>{root.release-audition();root.cancel-note();}
                keyboard := Rectangle {
                    x:0;y:0;width:root.keyboard-width;height:parent.height;clip:true;background:#d2dfe5;
                    for key in root.key-items : Rectangle {
                        x:0;y:key.y*1px;width:parent.width;height:key.h*1px;
                        background:key-touch.pressed ? #84deb8 : key.black ? #1b2c3c : #d7e2e8;
                        Rectangle {x:0;y:0;width:key.c ? 4px : 0px;height:parent.height;background:#52b892;}
                        Rectangle {x:0;y:parent.height - 1px;width:parent.width;height:1px;background:key.c ? #4d987f : #8196a7;}
                        Text {x:7px;y:0;width:parent.width - 13px;height:parent.height;text:key.label;
                            color:key.black ? #dae8f1 : #193343;font-size:key.h>=22 ? 12px : 10px;font-weight:key.c ? 700 : 400;vertical-alignment:center;horizontal-alignment:root.is-drums ? left : right;overflow:elide;}
                        key-touch := TouchArea {
                            accessible-role:button;accessible-label:key.label+" · MIDI "+key.pitch;
                            pointer-event(event)=>{
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {piano-focus.focus();root.key-gate(key.pitch,true);}
                                if event.kind==PointerEventKind.up || event.kind==PointerEventKind.cancel {root.key-gate(key.pitch,false);}
                            }
                            moved=>{if self.pressed && (self.mouse-x<0px || self.mouse-x>=self.width || self.mouse-y<0px || self.mouse-y>=self.height) {root.release-audition();}}
                            scroll-event(event)=>{root.piano-wheel(event.delta-x/1px,event.delta-y/1px);accept}
                            Tooltip {text:@markdown("\{key.label} · MIDI \{key.pitch}");}
                        }
                    }
                }
                grid := Rectangle {
                    x:root.keyboard-width;y:0;width:parent.width - self.x;height:parent.height;background:#101923;clip:true;
                    for key in root.key-items : Rectangle {
                        x:0;y:key.y*1px;width:parent.width;height:key.h*1px;background:key.black ? #131e2a : #172332;
                        Rectangle {x:0;y:parent.height - 1px;height:1px;width:parent.width;background:key.c ? #41705c : #233246;}
                    }
                    for line in root.piano-beat-count*4+4 : Rectangle {
                        x:((line+root.piano-first-line)/4 - root.scroll-beat)*root.pixels-per-beat*1px;y:0;width:1px;height:parent.height;
                        background:Math.mod(line+root.piano-first-line,4)==0 ? #35475e : #202e40;
                    }
                    Rectangle {x:root.clip-length-beats*root.pixels-per-beat*1px - root.scroll-beat*root.pixels-per-beat*1px;y:0;width:max(0px,parent.width - self.x);height:parent.height;background:#070c13b0;}
                    for note in root.note-items : Rectangle {
                        x:note.x*1px;y:note.y*1px;width:note.w*1px;height:note.h*1px;
                        background:note.selected ? #e7c77b : #62bfa6;border-radius:2px;
                        Text {x:3px;y:0;width:parent.width - 5px;height:parent.height;text:note.label;color:#102b29;font-size:9px;vertical-alignment:center;overflow:elide;}
                    }
                    if root.playhead-x>=0 && root.playhead-x<root.canvas-width : Rectangle {x:root.playhead-x*1px;y:0;width:2px;height:parent.height;background:#edf8ff;}
                    TouchArea {
                        pointer-event(event)=>{
                            if event.kind==PointerEventKind.down {piano-focus.focus();root.down(self.mouse-x/1px,self.mouse-y/1px,event.button==PointerEventButton.right);}
                            if event.kind==PointerEventKind.up {root.up(self.mouse-x/1px,self.mouse-y/1px);}
                            if event.kind==PointerEventKind.cancel {root.cancel-note();}
                        }
                        moved=>{root.moved(self.mouse-x/1px,self.mouse-y/1px);}
                        scroll-event(event)=>{root.piano-wheel(event.delta-x/1px,event.delta-y/1px);accept}
                    }
                }
            }
            ScrollView {
                x:parent.width - 12px;y:piano-focus.y;width:12px;min-width:12px;height:piano-focus.height;
                content-width:self.visible-width;content-height:128*root.piano-row-height*1px;content-y<=>root.piano-bar-y;
                horizontal-scrollbar-policy:always-off;vertical-scrollbar-policy:always-on;
                scrolled=>{root.scroll-piano(-root.piano-bar-x/1px/root.pixels-per-beat,-self.content-y/1px);}
            }
            ScrollView {
                x:root.keyboard-width;y:piano-focus.y+piano-focus.height;width:parent.width - self.x - 12px;height:16px;min-height:16px;
                content-width:max(self.visible-width,root.clip-length-beats*root.pixels-per-beat*1px);content-height:self.visible-height;content-x<=>root.piano-bar-x;
                horizontal-scrollbar-policy:always-on;vertical-scrollbar-policy:always-off;
                scrolled=>{root.scroll-piano(-self.content-x/1px/root.pixels-per-beat,-root.piano-bar-y/1px);}
            }
            HorizontalLayout {
                x:0;y:parent.height - 25px;width:parent.width;height:24px;spacing:5px;
                Text {text:root.selected-label;color:#93a7bd;font-size:10px;overflow:elide;horizontal-stretch:1;vertical-alignment:center;}
                Text {text:"Velocity";color:#a0b6c9;vertical-alignment:center;font-size:10px;}
                SpinBox {width:82px;value<=>root.note-velocity;minimum:1;maximum:127;enabled:root.selected-note-id!="0";edited(value)=>{root.velocity(value);}}
            }
        }
    }
    inspector := Rectangle {
        x: root.width - root.inspector-width - 8px; y: 74px; width: root.inspector-width; height: root.height - 124px;
        visible: root.inspector-visible; background: #141e2b; border-radius: 5px;
        HorizontalLayout {
            x: 10px; y: 6px; width: parent.width - 20px; height: 30px; spacing: 5px;
            Button { text: "Track"; checked: !root.project-tab && !root.sound-tab; clicked => { root.project-tab = false; root.sound-tab = false; root.inspector-scroll = 0px; } }
            sound-tab-button := Button { text: "Sound"; checked: root.sound-tab && !root.project-tab; clicked => { root.project-tab = false; root.sound-tab = true; root.inspector-scroll = 0px; } }
            Button { text: "Project"; checked: root.project-tab; clicked => { root.project-tab = true; root.sound-tab = false; root.inspector-scroll = 0px; } }
        }
        ScrollView {
            x: 12px; y: 48px; width: parent.width - 24px; height: parent.height - 60px;
            horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
            content-height: root.project-tab ? 360px : root.sound-tab ? (root.is-drums ? 1080px : 710px) : 810px;
            content-y <=> root.inspector-scroll;
            VerticalLayout {
                visible: !root.project-tab && !root.sound-tab;
                x: 0; y: 0; width: parent.width - 8px; height: 810px; spacing: 7px;
                Text { height: 18px; text: "SELECTED TRACK  ·  " + (root.track-index + 1); color: #7edcba; font-size: 11px; }
                name-edit := LineEdit { height: 30px; text <=> root.track-name-draft; accepted => { root.rename-track(root.track-id, self.text); } }
                Button { height: 28px; text: "Rename"; clicked => { root.rename-track(root.track-id, name-edit.text); } }
                ComboBox { height: 30px; model: ["Mint", "Blue", "Amber", "Violet", "Rose", "Cyan"]; current-index <=> root.color-index;
                    selected(value) => { root.color-track(root.track-id, self.current-index); } }
                Text { height: 18px; text: root.instrument + "  ·  independent instance"; color: #a0b4ca; font-size: 10px; }
                Text { height: 18px; text: "Output → Master"; color: #c1d2e3; }
                HorizontalLayout {
                    height: 30px; spacing: 5px;
                    inspector-mute := Button { text: "Mute"; accessible-checkable: true; accessible-checked: root.muted; checked: root.muted;
                        clicked => { root.toggle-mute(root.track-id); } }
                    Button { text: "Solo"; accessible-checkable: true; accessible-checked: root.soloed; checked: root.soloed;
                        clicked => { root.toggle-solo(root.track-id); } }
                }
                Text { height: 18px; text: root.audible ? "Audible · solo is cumulative" : root.muted ? "Muted · fader value retained" : "Excluded by another solo";
                    color: root.audible ? #79d8b5 : #e0bd7b; font-size: 10px; }
                Text { height: 18px; text: "Volume  " + round(root.gain * 100) + "%"; color: #c7d4e5; }
                gain-slider := Slider { height: 26px; value <=> root.gain; minimum: 0; maximum: 2;
                    changed(value) => { root.set-gain(root.track-id, value); } released(value) => { root.finish-mix(); } }
                Text { height: 18px; text: "Pan  " + round(root.pan * 100); color: #c7d4e5; }
                Slider { height: 26px; value <=> root.pan; minimum: -1; maximum: 1;
                    changed(value) => { root.set-pan(root.track-id, value); } released(value) => { root.finish-mix(); } }
                Text { height: 18px; text: root.mix-label; color: #7e96b0; font-size: 10px; }
                HorizontalLayout {
                    height: 30px; spacing: 4px;
                    Button { text: "↑"; enabled: root.track-index > 0; clicked => { root.move-track(root.track-id, -1); } }
                    Button { text: "↓"; enabled: root.track-index < root.track-items.length - 1; clicked => { root.move-track(root.track-id, 1); } }
                    Button { text: "Remove"; enabled: root.track-items.length > 1; clicked => { root.remove-track(root.track-id); } }
                }
                Text { height: 30px; text: "Drag ≡ to reorder tracks.\nTrack / note edits stop playback."; color: #8b9eb3; font-size: 10px; }
                Rectangle { height: 1px; background: #293747; }
                Button { height: 30px; text: "Use oscillator instrument"; enabled: !root.is-synth; clicked => { root.use-sine(root.track-id); } }
                Button {height:30px;text:"Use CC0 drum kit";enabled:!root.is-drums;clicked=>{root.use-drums(root.track-id);root.sound-tab=true;root.inspector-scroll=0px;}}
                sample-file := LineEdit { height: 30px; text <=> root.sample-path; placeholder-text: "Path to short WAV sample"; }
                HorizontalLayout {
                    height: 30px;
                    Text { text: "Root MIDI"; color: #c7d4e5; vertical-alignment: center; }
                    root-note := SpinBox { minimum: 0; maximum: 127; value <=> root.sample-root; }
                }
                one-shot := CheckBox { height: 26px; text: "One-shot"; checked <=> root.sample-one-shot; }
                Button { height: 30px; text: "Load WAV into this track";
                    clicked => { root.import-sample(root.track-id, sample-file.text, root-note.value, one-shot.checked); } }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                visible: root.sound-tab && !root.project-tab && !root.is-drums;
                x: 0; y: 0; width: parent.width - 8px; height: 710px; spacing: 7px;
                Text { height: 18px; text: "SOUND  ·  " + root.track-name; color: #7edcba; overflow: elide; }
                Text { height: 18px; text: root.is-synth ? root.preset-label : "Sampler · controls in Track"; color: #c7d4e5; overflow: elide; }
                HorizontalLayout {
                    height: 30px; spacing: 5px;
                    ComboBox { enabled: root.is-synth; model: ["Legacy Sine", "Warm Saw", "Hollow Pulse", "Soft Triangle", "Short Pluck"]; current-index <=> root.factory-index; }
                    preset-apply := Button { text: "Apply"; enabled: root.is-synth;
                        clicked => { root.factory-preset(root.track-id, root.instance-id, root.factory-index); } }
                }
                waveform-combo := ComboBox { height: 30px; enabled: root.is-synth; model: ["Sine", "Saw", "Square / PWM", "Triangle"]; current-index <=> root.synth-wave;
                    selected(value) => { root.synth-parameter(root.track-id, root.instance-id, 0, self.current-index); root.finish-mix(); } }
                Text { height: 18px; text: "Shape  " + round(root.synth-shape * 100) + "%  ·  sine → wave"; color: #c7d4e5; }
                shape-slider := Slider { height: 26px; enabled: root.is-synth && root.synth-wave != 0; minimum: 0; maximum: 1; value <=> root.synth-shape;
                    changed(value) => { root.synth-parameter(root.track-id, root.instance-id, 1, value); } released(value) => { root.finish-mix(); } }
                Text { height: 18px; text: "Pulse width  " + round(root.synth-duty * 100) + "%"; color: #c7d4e5; }
                duty-slider := Slider { height: 26px; enabled: root.is-synth && root.synth-wave == 2; minimum: 0.05; maximum: 0.95; value <=> root.synth-duty;
                    changed(value) => { root.synth-parameter(root.track-id, root.instance-id, 2, value); } released(value) => { root.finish-mix(); } }
                HorizontalLayout { height: 30px;
                    Text { text: "Attack · ms"; color: #c7d4e5; vertical-alignment: center; }
                    attack-spin := SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 10000; value <=> root.synth-attack;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 3, value / 1000.0); root.finish-mix(); } }
                }
                HorizontalLayout { height: 30px;
                    Text { text: "Decay · ms"; color: #c7d4e5; vertical-alignment: center; }
                    SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 10000; value <=> root.synth-decay;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 4, value / 1000.0); root.finish-mix(); } }
                }
                HorizontalLayout { height: 30px;
                    Text { text: "Sustain · %"; color: #c7d4e5; vertical-alignment: center; }
                    SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 100; value <=> root.synth-sustain;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 5, value / 100.0); root.finish-mix(); } }
                }
                HorizontalLayout { height: 30px;
                    Text { text: "Release · ms"; color: #c7d4e5; vertical-alignment: center; }
                    SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 20000; value <=> root.synth-release;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 6, value / 1000.0); root.finish-mix(); } }
                }
                Text { height: 32px; text: "ADSR applies to new notes.\nWave / shape / PWM fade in 10 ms."; color: #96abc0; font-size: 10px; }
                Text { height: 28px; text: "Volume / pan: Track tab.\nOne oscillator · independent voices."; color: #96abc0; font-size: 10px; }
                Rectangle { height: 1px; background: #293747; }
                Text { height: 18px; text: "USER PRESET"; color: #8295ad; font-size: 11px; }
                LineEdit { height: 30px; text <=> root.preset-name; placeholder-text: "Preset name"; }
                LineEdit { height: 30px; text <=> root.preset-path; placeholder-text: "Path to .synth.json"; }
                HorizontalLayout { height: 30px; spacing: 5px;
                    save-preset-button := Button { text: "Save preset"; enabled: root.is-synth; clicked => { root.save-synth-preset(root.track-id, root.instance-id, root.preset-path, root.preset-name); } }
                    load-preset-button := Button { text: "Load preset"; enabled: root.is-synth; clicked => { root.load-synth-preset(root.track-id, root.instance-id, root.preset-path); } }
                }
                Text { height: 28px; text: "Presets copy values into this track.\nNotes and track volume are retained."; color: #96abc0; font-size: 10px; }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                visible: root.sound-tab && !root.project-tab && root.is-drums;
                x:0;y:0;width:parent.width - 8px;height:1080px;spacing:7px;
                Text {height:18px;text:root.drum-kit-name;color:#7edcba;overflow:elide;font-size:12px;}
                Text {height:18px;text:"GM subset · 16 pads · independent kit";color:#96abc0;font-size:10px;}
                HorizontalLayout {height:30px;spacing:4px;
                    Text {text:"Preview velocity";color:#c7d4e5;vertical-alignment:center;font-size:11px;}
                    SpinBox {width:88px;minimum:1;maximum:127;value<=>root.pad-preview-velocity;}
                }
                drum-focus := FocusScope {
                    height:216px;focus-lost(reason)=>{root.release-audition();}
                    for pad[index] in root.drum-pads : Rectangle {
                        x:(index - floor(index/4)*4)*(parent.width/4);y:floor(index/4)*54px;
                        width:parent.width/4 - 4px;height:50px;border-radius:4px;
                        background:pad-touch.pressed || root.pad-pulses[index] ? #43896f : pad.filled ? #243a4c : #18212c;
                        border-width:root.pad-id==pad.id ? 2px : 1px;border-color:root.pad-id==pad.id ? #8be0bd : #3a4a5b;
                        Text {x:4px;y:4px;width:parent.width - 8px;height:27px;text:pad.name;wrap:word-wrap;overflow:elide;color:pad.filled ? #e0eaf3 : #8b9eb3;font-size:9px;}
                        Text {x:4px;y:34px;width:parent.width - 8px;height:12px;text:pad.filled ? (root.pad-mutes[index] ? "M · " : "")+pad.midi : "Empty · "+pad.midi;color:#9cb2c8;font-size:8px;}
                        pad-touch := TouchArea {
                            accessible-role:button;accessible-label:pad.name+" · MIDI "+pad.midi;
                            pointer-event(event)=>{
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {drum-focus.focus();root.select-pad(pad.id);root.drum-pad-gate(pad.id,true);}
                                if event.kind==PointerEventKind.up {root.drum-pad-gate(pad.id,false);}
                                if event.kind==PointerEventKind.cancel {root.release-audition();}
                            }
                            moved=>{if self.pressed && (self.mouse-x<0px || self.mouse-x>=self.width || self.mouse-y<0px || self.mouse-y>=self.height){root.release-audition();}}
                            Tooltip {text:@markdown("\{pad.name} · MIDI \{pad.midi}");}
                        }
                    }
                }
                Text {height:18px;text:"SELECTED PAD · MIDI "+root.pad-midi;color:#7edcba;font-size:11px;}
                pad-name-edit := LineEdit {height:30px;text<=>root.pad-name;accepted=>{root.rename-pad(self.text);}}
                Button {height:28px;text:"Rename pad";clicked=>{root.rename-pad(pad-name-edit.text);}}
                HorizontalLayout {height:30px;spacing:4px;
                    Text {text:"MIDI";color:#c7d4e5;vertical-alignment:center;}
                    pad-map-spin := SpinBox {minimum:0;maximum:127;value<=>root.pad-midi;width:88px;}
                    pad-map-button := Button {text:"Apply map";clicked=>{root.map-pad(pad-map-spin.value);}}
                }
                HorizontalLayout {height:30px;spacing:5px;
                    pad-mute-button := Button {text:"Mute";checked:root.pad-muted;accessible-checkable:true;accessible-checked:root.pad-muted;clicked=>{root.toggle-pad(3);}}
                    pad-mode-button := Button {text:root.pad-one-shot ? "One-shot" : "Gated";checked:root.pad-one-shot;accessible-checkable:true;accessible-checked:root.pad-one-shot;clicked=>{root.toggle-pad(4);}}
                }
                Text {height:18px;text:"Pad volume  "+round(root.pad-gain*100)+"%";color:#c7d4e5;}
                pad-gain-slider := Slider {height:26px;minimum:0;maximum:4;value<=>root.pad-gain;changed(value)=>{root.pad-parameter(0,value);}released(value)=>{root.finish-mix();}}
                Text {height:18px;text:"Pad pan  "+round(root.pad-pan*100);color:#c7d4e5;}
                pad-pan-slider := Slider {height:26px;minimum:-1;maximum:1;value<=>root.pad-pan;changed(value)=>{root.pad-parameter(1,value);}released(value)=>{root.finish-mix();}}
                HorizontalLayout {height:30px;
                    Text {text:"Tune · semitones";color:#c7d4e5;vertical-alignment:center;font-size:11px;}
                    SpinBox {minimum:-24;maximum:24;width:88px;value<=>root.pad-tune;edited(value)=>{root.pad-parameter(2,value);root.finish-mix();}}
                }
                HorizontalLayout {height:30px;
                    Text {text:"Choke · 0 = none";color:#c7d4e5;vertical-alignment:center;font-size:11px;}
                    SpinBox {minimum:0;maximum:16;width:88px;value<=>root.pad-choke;edited(value)=>{root.pad-parameter(5,value);root.finish-mix();}}
                }
                Text {height:38px;text:"Tune / mode / choke apply to new hits.\nHi-hats share choke group 1.\nTrack volume / pan: Track tab.";color:#96abc0;font-size:10px;}
                Rectangle {height:1px;background:#293747;}
                Text {height:32px;text:root.pad-filled ? root.pad-source : "Empty pad · import a WAV";color:#9db1c7;font-size:10px;wrap:word-wrap;overflow:elide;}
                LineEdit {height:30px;text<=>root.pad-import-path;placeholder-text:"Path to replacement WAV";}
                HorizontalLayout {height:30px;spacing:5px;
                    pad-import-button := Button {text:"Replace WAV";clicked=>{root.import-pad(root.pad-import-path);}}
                    pad-clear-button := Button {text:"Clear";enabled:root.pad-filled;clicked=>{root.clear-pad();}}
                }
                Text {height:48px;text:"One-shots finish after button release.\nFocus / track changes cancel previews.\nMapping and sample edits stop playback;\nUndo restores the previous pad.";color:#96abc0;font-size:10px;}
                Button {height:30px;text:"Reset CC0 kit";clicked=>{root.use-drums(root.track-id);}}
                Text {height:28px;text:"VCSL · Versilian Studios · CC0 1.0\nTwelve sounds; four empty pads for import.";color:#8295ad;font-size:10px;}
                Rectangle {vertical-stretch:1;}
            }
            VerticalLayout {
                visible: root.project-tab;
                x: 0; y: 0; width: parent.width - 8px; height: 460px; spacing: 8px;
                Text { height: 18px; text: "PROJECT FOLDER"; color: #8295ad; font-size: 11px; }
                Text { height: 58px; text: root.project-path == "" ? "Choose a folder with Save as…" : root.project-path; wrap: char-wrap; color: #c7d4e5; font-size: 11px; }
                HorizontalLayout { height: 30px;
                    Button { text: "Save"; clicked => { root.request-save(); } }
                    Button { text: "Save as…"; clicked => { root.show-save-as(); } }
                }
                Button { height: 30px; text: "Open project folder"; enabled: root.project-path != ""; clicked => { root.reveal-project(); } }
                Button { height: 30px; text: "New / Recent projects…"; enabled: !root.export-busy; clicked => { root.show-projects(); } }
                HorizontalLayout { height: 30px;
                    Text { text: "Tempo"; color: #c7d4e5; vertical-alignment: center; }
                    SpinBox { value <=> root.bpm; minimum: 30; maximum: 300; edited(value) => { root.tempo(value); } }
                }
                Text { height: 18px; text: "WAV EXPORT"; color: #8295ad; font-size: 11px; }
                LineEdit { height: 30px; text <=> root.export-path; }
                Button { height: 30px; text: root.export-busy ? "Exporting…" : "Export PCM16 WAV"; enabled: !root.export-busy;
                    clicked => { root.export-audio(root.export-path); } }
                Text { height: 34px; text: "Export includes track mute / solo.\nPlayback continues independently."; color: #96abc0; font-size: 11px; }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
    Rectangle {
        x: 0; y: root.height - 42px; width: root.width; height: 42px; background: #151e29;
        Text { x: 12px; y: 4px; height: 19px; width: parent.width - 218px;
            text: root.action-error != "" ? root.action-error : root.arrangement-limited ? "Preview limited to 256 clips; zoom in." : root.status;
            color: root.action-error != "" ? #f2b6a1 : #a8b9cd; vertical-alignment: center; overflow: elide; font-size: 11px; }
        Text { x: 12px; y: 24px; height: 14px; text: root.pending-actions > 0 ? root.pending-actions + " actions pending" : root.mix-label;
            color: #7891ac; font-size: 9px; }
        Rectangle { x: parent.width - 190px; y: 10px; width: 170px; height: 6px; background: #29384a;
            Rectangle { x: 0; y: 0; width: parent.width * root.peak-left; height: parent.height; background: #70dcb5; } }
        Rectangle { x: parent.width - 190px; y: 23px; width: 170px; height: 6px; background: #29384a;
            Rectangle { x: 0; y: 0; width: parent.width * root.peak-right; height: parent.height; background: #70dcb5; } }
    }
    Rectangle {
        visible: root.home-visible;
        x: 0; y: 0; width: parent.width; height: parent.height - 42px; background: #0d1117;
        TouchArea { }
        VerticalLayout {
            x: (parent.width - 900px) / 2; y: 46px; width: 900px; height: parent.height - 82px; spacing: 18px;
            HorizontalLayout { height: 38px;
                Text { text: "OPENDAW"; color: #79e3bf; font-size: 28px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Button { visible: root.has-project; text: "Back to project"; clicked => { root.home-visible = false; } }
            }
            Text { height: 32px; text: "Your next session starts here."; color: #edf4ff; font-size: 23px; }
            HorizontalLayout { spacing: 22px;
                Rectangle { width: 360px; background: #151e2b; border-radius: 10px;
                    VerticalLayout { padding: 22px; spacing: 12px;
                        Text { height: 28px; text: "New project"; color: #edf4ff; font-size: 20px; font-weight: 600; }
                        Text { height: 28px; text: "Start with an empty instrument track."; color: #96abc0; font-size: 12px; }
                        Text { height: 18px; text: "PROJECT NAME"; color: #8295ad; font-size: 11px; }
                        LineEdit { height: 36px; text <=> root.new-name; placeholder-text: "My song"; }
                        Text { height: 18px; text: "SAVE IN"; color: #8295ad; font-size: 11px; }
                        LineEdit { height: 36px; text <=> root.new-parent; placeholder-text: "Choose a folder"; }
                        Button { height: 32px; text: "Choose folder…"; clicked => { root.browse-folder(0); } }
                        Text { height: 52px; text: "A new .opendaw folder will contain your\nproject and its audio samples."; color: #96abc0; font-size: 12px; wrap: word-wrap; }
                        create-project-button := Button { height: 40px; text: "Create project"; enabled: root.new-name != "" && root.new-parent != "" && root.pending-actions == 0 && !root.export-busy;
                            clicked => { root.request-switch(1, root.new-parent, root.new-name); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: #111923; border-radius: 10px;
                    VerticalLayout { padding: 22px; spacing: 12px;
                        HorizontalLayout { height: 32px;
                            Text { text: "Recent projects"; color: #edf4ff; font-size: 20px; font-weight: 600; }
                            Button { text: "Open project…"; enabled: !root.export-busy; clicked => { root.choose-open-project(); } }
                        }
                        Text { visible: root.recent-projects.length == 0; height: root.recent-projects.length == 0 ? 68px : 0px; text: "No recent projects yet.\nCreate a project or open an existing .opendaw folder."; color: #96abc0; font-size: 12px; wrap: word-wrap; }
                        recent-scroll := ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout { spacing: 8px;
                                for project in root.recent-projects : Rectangle {
                                    height: 72px; background: #1b2838; border-radius: 6px;
                                    VerticalLayout { padding: 10px; spacing: 5px;
                                        Text { text: project.name + (project.available ? "" : " · unavailable"); color: project.available ? #e7f1fc : #b6a18d; font-size: 14px; overflow: elide; }
                                        Text { text: project.path; color: #8299b2; font-size: 10px; overflow: elide; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.request-switch(0, project.path, ""); }
                                        Tooltip { text: @markdown("\{project.path}"); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.save-as-visible : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 560px; height: 360px; background: #1b293a; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 12px;
                Text { text: "Save project as…"; color: #edf4ff; font-size: 23px; }
                Text { text: "Create a portable copy in a new .opendaw folder."; color: #adbed1; }
                LineEdit { height: 34px; text <=> root.save-as-name; placeholder-text: "Project folder name"; }
                LineEdit { height: 34px; text <=> root.save-as-parent; placeholder-text: "Save in"; }
                Button { height: 30px; text: "Choose folder…"; clicked => { root.browse-folder(1); } }
                Text { height: 40px; text: root.action-error; color: #f2b6a1; wrap: word-wrap; font-size: 11px; }
                HorizontalLayout { height: 34px;
                    Button { text: "Cancel"; clicked => { root.save-as-visible = false; } }
                    Button { text: "Save copy"; enabled: root.pending-actions == 0; clicked => { root.save-project-as(root.save-as-parent, root.save-as-name); } }
                }
            }
        }
    }
    Rectangle {
        visible: root.confirm-switch;
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 580px; height: 250px; background: #1b293a; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: "Save changes before switching?"; color: #edf4ff; font-size: 23px; }
                Text { text: "Choose what to do with edits to " + root.project-name + "."; color: #adbed1; wrap: word-wrap; }
                Text { height: 40px; text: root.action-error; color: #f2b6a1; wrap: word-wrap; font-size: 11px; }
                HorizontalLayout { height: 34px;
                    Button { text: "Cancel"; clicked => { root.confirm-switch = false; } }
                    switch-discard-button := Button { text: "Discard and continue"; enabled: root.pending-actions == 0; clicked => { root.switch-project(root.pending-project-kind, root.pending-project-path, root.pending-project-name, 2); } }
                    switch-save-button := Button { text: "Save and continue"; enabled: root.pending-actions == 0; clicked => { root.switch-project(root.pending-project-kind, root.pending-project-path, root.pending-project-name, 1); } }
                }
            }
        }
    }
    if root.about-visible : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 420px; height: 320px; background: Palette.background; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: "OpenDAW 0.2.0"; color: Palette.foreground; font-size: 23px; }
                Text { text: "Music creation with a C++ audio engine and Slint interface."; color: Palette.foreground; wrap: word-wrap; }
                AboutSlint { }
                Button { text: "Close"; clicked => { root.about-visible = false; } }
            }
        }
    }
    if root.confirm-close : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 480px; height: 190px; background: #1b293a; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: "Close OpenDAW?"; color: #eef6ff; font-size: 23px; }
                Text { text: "Save your edits before closing. Unsaved changes will be lost."; color: #adbed1; wrap: word-wrap; }
                HorizontalLayout {
                    Button { text: "Keep editing"; clicked => { root.confirm-close = false; } }
                    Button { text: "Save"; clicked => { root.request-save(); root.confirm-close = false; } }
                    Button { text: "Discard and close"; clicked => { root.exit-confirmed(); } }
                }
            }
        }
    }
}
