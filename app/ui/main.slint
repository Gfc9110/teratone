    out property <float> inspector-toggle-y: inspector-toggle.absolute-position.y / 1px + inspector-toggle.height / 2px;
    out property <float> inspector-close-x: inspector-close.absolute-position.x / 1px + inspector-close.width / 2px;
    out property <float> inspector-close-y: inspector-close.absolute-position.y / 1px + inspector-close.height / 2px;
    out property <float> midi-view-x: midi-view-control.absolute-position.x / 1px + midi-view-control.width / 2px;
    out property <float> midi-view-y: midi-view-control.absolute-position.y / 1px + midi-view-control.height / 2px;
    out property <float> midi-snap-x: midi-snap-control.absolute-position.x / 1px + midi-snap-control.width / 2px;
    out property <float> midi-snap-y: midi-snap-control.absolute-position.y / 1px + midi-snap-control.height / 2px;
    out property <string> sound-context-label: root.is-drums ? drum-sound-label.text : synth-sound-label.text;
    out property <string> clip-context-label: editor-clip-label.text;
    out property <float> editor-toolbar-end-x: zoom-control.absolute-position.x / 1px + zoom-control.width / 1px;
    out property <float> workspace-right-x: main.absolute-position.x / 1px + main.width / 1px;
    callback play(); callback pause(); callback stop(); callback toggle-loop();
    callback select-track(string); callback select-clip(string, string);
    callback add-track(string); callback duplicate-track(string); callback remove-track(string);
    callback move-track(string, int); callback reorder-track(string, int);
    callback rename-track(string, string); callback color-track(string, int);
    callback toggle-mute(string); callback toggle-solo(string);
    callback tempo(int); callback set-gain(string, float); callback set-pan(string, float); callback finish-mix();
    callback undo(); callback redo(); callback remove-note();
    callback zoom-y(float); callback fit-notes(); callback restore-view(); callback notation(int); callback scroll-piano(float,float);
    callback toggle-reference(string,string); callback toggle-reference-pin(string,string); callback hide-references(); callback follow-selection-changed(bool); callback activate-editor-clip(string,string);
    callback set-midi-view-mode(int);
    callback set-scale(int,int);
    callback set-snap(int); callback zoom-at(float,float); callback set-navigation-linked(bool);
    callback select-velocity-note(string); callback set-velocity-note(string,int);
    callback key-gate(int,bool); callback release-audition(); callback cancel-note(); callback velocity(int);
    callback new-clip(string,float); callback duplicate-clip(string,string); callback remove-clip(string,string);
    callback rename-clip(string,string,string); callback move-clip(string,string,string,float); callback resize-clip(string,string,float);
    callback zoom(float); callback pan-view(int); callback pitch-view(int); callback seek(float); callback seek-project(float);
    callback down(float, float, bool, bool); callback moved(float, float); callback up(float, float); callback delete-note-at(string,string,float,float); callback double-click-note();
    callback save-project(string); callback open-project(string);
    callback switch-project(int, string, string, int);
    callback browse-folder(int); callback choose-open-project(); callback reveal-project();
    callback save-project-as(string, string);
    callback add-drums(string);callback use-drums(string);callback select-pad(string);
    callback drum-pad-gate(string,bool);callback pad-parameter(int,float);callback toggle-pad(int);
    callback rename-pad(string);callback map-pad(int);callback import-pad(string);callback clear-pad();
    callback release-keyboard();
    callback synth-parameter(string, string, int, float);
    callback factory-preset(string, string, int);
    callback save-synth-preset(string, string, string, string);
    callback load-synth-preset(string, string, string);
    callback export-audio(string); callback import-sample(string, string, int, bool); callback use-sine(string);
    callback exit-confirmed();
    public function select-track-context(id: string) {
        root.select-track(id);
        if root.inspector-visible && !root.sound-tab && !root.project-tab { root.inspector-detail = 0; root.inspector-scroll = 0px; }
    }
    public function select-clip-context(track: string, clip: string) {
        root.select-clip(track, clip);
        if root.inspector-visible && !root.sound-tab && !root.project-tab { root.inspector-detail = 1; root.inspector-scroll = 0px; }
    }
    public function show-projects() {
        if !root.export-busy { root.cancel-interactions(); root.stop(); root.home-visible = true; }
    }
    public function request-switch(kind: int, path: string, name: string) {
        root.cancel-interactions();
        if root.dirty || root.pending-actions > 0 {
            root.pending-project-kind = kind; root.pending-project-path = path; root.pending-project-name = name;
            root.confirm-switch = true;
        } else { root.switch-project(kind, path, name, 0); }
    }
    public function request-save() {
        if root.project-path == "" {
            root.save-as-name = root.project-name; root.save-as-parent = root.new-parent; root.save-as-visible = true;
        } else { root.save-project(root.project-path); }
    }
    public function show-save-as() {
        root.cancel-interactions(); root.save-as-name = root.project-name + " copy";
        root.save-as-parent = root.new-parent; root.save-as-visible = true;
    }
    private property <string> clip-drag-id;
    private property <string> clip-drag-track;
    private property <float> clip-press-beat;
    private property <float> clip-press-y;
    private property <float> clip-pointer-x;
    private property <float> clip-pointer-y;
    private property <float> clip-base-start;
    private property <float> clip-base-length;
    private property <float> clip-preview-start;
    private property <float> clip-preview-length;
    private property <int> clip-target-index;
    private property <bool> clip-resizing;
    private property <bool> clip-dragging;
    // A middle-button drag pans the visible canvas without changing its contents.
    // Pointer coordinates are global so scrolling a clip or row under the
    // pointer does not change the measured movement.
    private property <int> middle-pan-target: 0;
    out property <int> middle-pan-state: root.middle-pan-target;
    private property <length> middle-pan-x;
    private property <length> middle-pan-y;
    public function begin-middle-pan(target:int, x:length, y:length) {
        root.cancel-interactions();
        root.middle-pan-target=target; root.middle-pan-x=x; root.middle-pan-y=y;
    }
    public function move-middle-pan(x:length, y:length) {
        let dx=x - root.middle-pan-x; let dy=y - root.middle-pan-y;
        root.middle-pan-x=x; root.middle-pan-y=y;
        if root.middle-pan-target==1 {
            root.arrangement-x+=dx; root.arrangement-y+=dy; root.clamp-scroll();
        } else if root.middle-pan-target==2 {
            root.piano-wheel(dx/1px,dy/1px);
        }
    }
    public function end-middle-pan() { root.middle-pan-target=0; }
    public function piano-wheel(dx:float,dy:float) {
        root.piano-bar-y=min(0px,max(min(0px,root.canvas-height*1px - root.piano-row-count*root.piano-row-height*1px),root.piano-bar-y+dy*1px));
        root.piano-bar-x=min(0px,max(min(0px,root.canvas-width*1px - root.clip-length-beats*root.pixels-per-beat*1px),root.piano-bar-x+dx*1px));
        root.scroll-piano(-root.piano-bar-x/1px/root.pixels-per-beat,-root.piano-bar-y/1px);
    }
    // The anchor is expressed in timeline-canvas pixels, not header pixels.
    public function arrangement-zoom-at(factor:float, anchor:float) {
        let beat=(anchor - root.arrangement-x/1px)/root.arrangement-zoom;
        root.arrangement-zoom=max(12,min(192,root.arrangement-zoom*factor));
        root.arrangement-x=(anchor - beat*root.arrangement-zoom)*1px;
        root.clamp-scroll();
    }
    public function cancel-interactions() {
        root.clip-drag-id="";root.clip-dragging=false;root.drag-id="";root.dragging=false;root.drop-index=-1;
        root.middle-pan-target=0;
        root.release-audition();root.cancel-note();
    }
    public function update-clip-drag() {
        if root.clip-drag-id!="" {
            let beat=(root.clip-pointer-x - root.rows-x - root.header-size - root.arrangement-x/1px)/root.arrangement-zoom;
            let delta=round((beat - root.clip-press-beat)*4)/4;
            if abs(delta)>0 || abs(root.clip-pointer-y - root.clip-press-y)>5 {root.clip-dragging=true;}
            if root.clip-resizing {root.clip-preview-length=max(0.25,root.clip-base-length+delta);}
            else {
                root.clip-preview-start=max(0,root.clip-base-start+delta);
                root.clip-target-index=max(0,min(root.track-items.length - 1,floor((root.clip-pointer-y - root.rows-y - root.arrangement-y/1px)/root.row-size)));
            }
        }
    }
    public function reveal-clip() {
        let start=root.clip-start-beat*root.arrangement-zoom*1px+root.arrangement-x;
        let end=start+root.clip-length-beats*root.arrangement-zoom*1px;
        if root.clip-id!="0" && min(end,root.lane-width*1px) - max(start,0px)<min(100px,root.clip-length-beats*root.arrangement-zoom*1px) {
            root.arrangement-x=-max(0,root.clip-start-beat - 1)*root.arrangement-zoom*1px;root.clamp-scroll();
        }
    }
    public function reveal-selected() {
        root.arrangement-y = min(0px, max(min(0px, rows.visible-height - rows.content-height),
            max(-root.inspector-track-index * root.row-height, min(root.arrangement-y, rows.visible-height - (root.inspector-track-index + 1) * root.row-height))));
    }
    public function tick-drag() {
        if root.clip-drag-id!="" && root.clip-dragging {
            if root.clip-pointer-y<root.rows-y+24 {root.arrangement-y=min(0px,root.arrangement-y+8px);}
            if root.clip-pointer-y>root.rows-y+root.rows-height - 24 {root.arrangement-y=max(min(0px,rows.visible-height - rows.content-height),root.arrangement-y - 8px);}
            if root.clip-pointer-x<root.rows-x+root.header-size+24 {root.arrangement-x=min(0px,root.arrangement-x+8px);}
            if root.clip-pointer-x>root.rows-x+root.header-size+root.lane-width - 24 {root.arrangement-x=max(min(0px,horizontal.visible-width - horizontal.content-width),root.arrangement-x - 8px);}
            root.update-clip-drag();
        }
        if root.drag-id != "" && root.dragging {
            if root.drag-pointer < root.rows-y + 24 { root.arrangement-y = min(0px, root.arrangement-y + 8px); }
            if root.drag-pointer > root.rows-y + root.rows-height - 24 {
                root.arrangement-y = max(min(0px, rows.visible-height - rows.content-height), root.arrangement-y - 8px);
            }
            root.drop-index = max(0, min(root.track-items.length - 1, floor((root.drag-pointer - root.rows-y - root.arrangement-y / 1px) / root.row-size)));
        }
    }
    public function clamp-scroll() {
        root.arrangement-y = min(0px, max(min(0px, rows.visible-height - rows.content-height), root.arrangement-y));
        root.arrangement-x = min(0px, max(min(0px, horizontal.visible-width - horizontal.content-width), root.arrangement-x));
    }
    MenuBar {
        Menu { title: "File";
            MenuItem { title: "New project / Recent projects…"; enabled: !root.export-busy; activated => { root.show-projects(); } }
            MenuItem { title: "Open project…"; enabled: !root.export-busy; activated => { root.choose-open-project(); } }
            MenuItem { title: "Save"; enabled: root.has-project; activated => { root.request-save(); } }
            MenuItem { title: "Save as…"; enabled: root.has-project; activated => { root.show-save-as(); } }
            MenuItem { title: "Open project folder"; enabled: root.project-path != ""; activated => { root.reveal-project(); } }
        }
        Menu { title: "Piano view";
            MenuItem { title: "Scroll down one octave"; activated => { root.pitch-view(-12); } }
            MenuItem { title: "Scroll up one octave"; activated => { root.pitch-view(12); } }
            MenuItem { title: root.notation-index == 0 ? "✓ Middle C: C3" : "Middle C: C3"; enabled: !root.is-drums; activated => { root.notation( -1); } }
            MenuItem { title: root.notation-index == 1 ? "✓ Middle C: C4" : "Middle C: C4"; enabled: !root.is-drums; activated => { root.notation(0); } }
            MenuItem { title: root.notation-index == 2 ? "✓ Middle C: C5" : "Middle C: C5"; enabled: !root.is-drums; activated => { root.notation(1); } }
            MenuItem { title: root.scale-mode == 0 ? "✓ Scale highlighting off" : "Scale highlighting off"; activated => { root.set-scale(0,root.scale-root); } }
            MenuItem { title: root.scale-mode == 1 ? "✓ Major scale" : "Major scale"; activated => { root.set-scale(1,root.scale-root); } }
            MenuItem { title: root.scale-mode == 2 ? "✓ Minor scale" : "Minor scale"; activated => { root.set-scale(2,root.scale-root); } }
        }
        Menu { title: "Scale root";
            MenuItem { title: "C"; activated => { root.set-scale(root.scale-mode,0); } }
            MenuItem { title: "C♯"; activated => { root.set-scale(root.scale-mode,1); } }
            MenuItem { title: "D"; activated => { root.set-scale(root.scale-mode,2); } }
            MenuItem { title: "D♯"; activated => { root.set-scale(root.scale-mode,3); } }
            MenuItem { title: "E"; activated => { root.set-scale(root.scale-mode,4); } }
            MenuItem { title: "F"; activated => { root.set-scale(root.scale-mode,5); } }
            MenuItem { title: "F♯"; activated => { root.set-scale(root.scale-mode,6); } }
            MenuItem { title: "G"; activated => { root.set-scale(root.scale-mode,7); } }
            MenuItem { title: "G♯"; activated => { root.set-scale(root.scale-mode,8); } }
            MenuItem { title: "A"; activated => { root.set-scale(root.scale-mode,9); } }
            MenuItem { title: "A♯"; activated => { root.set-scale(root.scale-mode,10); } }
            MenuItem { title: "B"; activated => { root.set-scale(root.scale-mode,11); } }
        }
        Menu { title: "Density";
            MenuItem { title: root.ui-density == 0 ? "✓ Compact" : "Compact"; activated => { root.ui-density = 0; } }
            MenuItem { title: root.ui-density == 1 ? "✓ Normal" : "Normal"; activated => { root.ui-density = 1; } }
            MenuItem { title: root.ui-density == 2 ? "✓ Touch" : "Touch"; activated => { root.ui-density = 2; } }
        }
        Menu { title: "Help"; MenuItem { title: "About OpenDAW"; activated => { root.about-visible = true; } } }
    }
    Rectangle {
        x: 0; y: 0; height: 40px; width: parent.width; background: #11161a;
        HorizontalLayout {
            x: 8px; y: 4px; width: parent.width - 16px; height: 32px; spacing: 4px;
            Text { text: "OPENDAW"; color: StudioTheme.accent; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            play-button := StudioIconButton {
                icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                label: root.playing ? "Pause" : "Play"; hint: root.playing ? "Pause playback" : "Start playback";
                checkable: true; checked: root.playing;
                clicked => { if root.playing { root.pause(); } else { root.play(); } }
            }
            StudioIconButton { icon: @image-url("icons/stop.svg"); label: "Stop"; hint: "Stop playback"; clicked => { root.stop(); } }
            StudioIconButton { icon: @image-url("icons/loop.svg"); label: "Loop"; hint: "Toggle loop"; checkable: true; checked: root.looping; clicked => { root.toggle-loop(); } }
            Text { text: root.transport-text; font-size: 17px; color: StudioTheme.text; vertical-alignment: center; }
            Text { text: "BPM"; color: StudioTheme.secondary; vertical-alignment: center; }
            tempo-control := TempoControl { value <=> root.bpm; edited(value) => { root.tempo(value); } }
            Text { text: root.silent-mode ? "SILENT CLOCK · no audio" : root.mix-label; color: root.silent-mode ? StudioTheme.mute : StudioTheme.secondary; font-size: 11px; vertical-alignment: center; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Projects"; enabled: !root.export-busy; clicked => { root.show-projects(); } }
        }
    }
    main := Rectangle {
        x: 6px; y: 44px; width: root.width - root.reserved-inspector-width - (root.reserved-inspector-width > 0px ? 18px : 12px); height: root.height - 70px;
        Rectangle { x: 0; y: 0; width: parent.width; height: root.toolbar-height; background: StudioTheme.panel; }
        HorizontalLayout {
            x: 0; y: 0; width: parent.width; height: root.toolbar-height; spacing: 4px;
            Text { text: "TRACKS  " + root.track-items.length + " / " + root.track-limit; color: #a6bdd4; vertical-alignment: center; }
            add-track-button := Button { text: "+ Track"; enabled: root.track-items.length < root.track-limit; clicked => { root.add-track(root.arrangement-track-id); } }
            add-drums-button := Button {text:"+ Drums";enabled:root.track-items.length<root.track-limit;clicked=>{root.add-drums(root.arrangement-track-id);if root.follow-selection {root.sound-tab=true;root.project-tab=false;root.inspector-scroll=0px;}}}
            duplicate-button := Button { text: "Duplicate"; enabled: root.track-items.length < root.track-limit; clicked => { root.duplicate-track(root.arrangement-track-id); } }
            Button { text: root.width < 1100px ? "Show" : "Show selected";accessible-label:"Show selected track"; clicked => { root.reveal-selected(); } }
            Rectangle { horizontal-stretch: 1; }
            focus-timeline := Button { text: root.workspace-focus == 1 ? "Combined" : "Timeline"; checked: root.workspace-focus == 1; clicked => { root.workspace-focus = root.workspace-focus == 1 ? 0 : 1; } }
            focus-piano := Button { text: root.workspace-focus == 2 ? "Combined" : "Piano"; checked: root.workspace-focus == 2; clicked => { root.workspace-focus = root.workspace-focus == 2 ? 0 : 2; } }
            Button { text: "−"; accessible-label: "Zoom timeline out"; clicked => { root.arrangement-zoom-at(0.8,root.lane-width/2); } Tooltip { text: @markdown("Zoom timeline out"); } }
            Button { text: "+"; accessible-label: "Zoom timeline in"; clicked => { root.arrangement-zoom-at(1.25,root.lane-width/2); } Tooltip { text: @markdown("Zoom timeline in"); } }
            inspector-toggle := Button { text: root.inspector-visible ? "Inspector ›" : "‹ Inspector"; clicked => { root.inspector-visible = !root.inspector-visible; } }
        }
        Rectangle {
            x: 0; y: root.toolbar-height + 2px; width: parent.width; height: 24px; background: #1a2633;
            Text { x: 12px; y: 5px; text: "TRACK / INSTRUMENT"; color: #91a7bf; font-size: 10px; }
            Rectangle {
                x: root.header-width; y: 0; width: parent.width - self.x; height: parent.height; clip: true;
                for beat in root.arrangement-beat-count : Text {
                    x: ((beat + root.arrangement-first-beat) * root.arrangement-zoom) * 1px + root.arrangement-x + 4px; y: 4px;
                    text: Math.mod(beat + root.arrangement-first-beat, 4) == 0 ? (floor((beat + root.arrangement-first-beat) / 4) + 1) + ".1" : "·";
                    color: #a6b9cf; font-size: 10px;
                }
                TouchArea {
                    mouse-cursor: root.middle-pan-target==1 ? grabbing : default;
                    clicked => { root.seek-project((self.mouse-x - root.arrangement-x) / 1px / root.arrangement-zoom); }
                    pointer-event(event) => {
                        if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {root.begin-middle-pan(1,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                        if (event.kind==PointerEventKind.up && event.button==PointerEventButton.middle) || event.kind==PointerEventKind.cancel {root.end-middle-pan();}
                    }
                    moved => {if root.middle-pan-target==1 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}}
                }
            }
        }
        clip-focus := FocusScope {
            x:0;y:root.toolbar-height+26px;width:parent.width;height:root.arrangement-height;
            focus-lost(reason) => {root.cancel-interactions();}
            key-pressed(event) => {
                if event.modifiers.control && (event.text == "z" || event.text == "Z") {
                    if event.modifiers.shift { root.redo(); } else { root.undo(); } return accept;
                }
                if event.modifiers.control && (event.text == "y" || event.text == "Y") { root.redo(); return accept; }
                if event.text == Key.Escape { root.cancel-interactions(); return accept; }
                reject
            }
        rows := ScrollView {
            x: 0; y: 0; width: parent.width; height: parent.height;
            content-width: self.visible-width; content-height: max(self.visible-height, root.track-items.length * root.row-height);
            content-y <=> root.arrangement-y;
            horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-on;
            // Keep empty timeline space pannable without covering track rows.
            Rectangle {
                x: root.header-width; y: 0; width: max(0px,rows.visible-width - self.x); height: rows.content-height;
                TouchArea {
                    mouse-cursor: root.middle-pan-target==1 ? grabbing : default;
                    pointer-event(event) => {
                        if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {root.begin-middle-pan(1,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                        if (event.kind==PointerEventKind.up && event.button==PointerEventButton.middle) || event.kind==PointerEventKind.cancel {root.end-middle-pan();}
                    }
                    moved => {if root.middle-pan-target==1 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}}
                }
            }
            for track[index] in root.track-items : Rectangle {
                x: 0; y: index * root.row-height; width: rows.visible-width; height: root.row-height;
                background: track.selected ? #29343a : StudioTheme.panel;
                header := Rectangle {
                    x: 0; y: 0; width: root.header-width; height: parent.height;
                    background: track.selected ? #2c3739 : StudioTheme.panel;
                    TouchArea {
                        clicked => { root.select-track-context(track.id); }
                        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { track-menu.show(); } }
                    }
                    Rectangle { x: 0; y: 0; width: 4px; height: parent.height - 1px; background: track.tint; }
                    Rectangle { x: parent.width - 2px; y: 0; width: track.selected ? 2px : 0px; height: parent.height - 1px; background: StudioTheme.selection; }
                    Text { x: 9px; y: 9px; text: "≡"; color: StudioTheme.secondary; }
                    handle := TouchArea {
                        x: 4px; y: 0; width: 24px; height: parent.height;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { track-menu.show(); }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                clip-focus.focus();root.drag-id = track.id; root.drag-index = index; root.drag-start = self.absolute-position.y / 1px + self.mouse-y / 1px;
                                root.drag-pointer = root.drag-start; root.dragging = false;
                            }
                            if event.kind == PointerEventKind.up && root.drag-id == track.id {
                                if root.dragging && root.drop-index >= 0 { root.reorder-track(track.id, root.drop-index); }
                                else { root.select-track-context(track.id); }
                                root.drag-id = ""; root.dragging = false; root.drop-index = -1;
                            }
                            if event.kind == PointerEventKind.cancel { root.drag-id = ""; root.dragging = false; root.drop-index = -1; }
                        }
                        moved => {
                            if self.pressed && root.drag-id == track.id {
                                root.drag-pointer = self.absolute-position.y / 1px + self.mouse-y / 1px;
                                if abs(root.drag-pointer - root.drag-start) > 4 { root.dragging = true; }
                                root.tick-drag();
                            }
                        }
                    }
                    Image {
                        x: 29px; y: 7px; width: 15px; height: 15px;
                        source: track.instrument == "Drum Kit" ? @image-url("icons/instrument-drums.svg") : track.instrument == "Sampler" ? @image-url("icons/instrument-sampler.svg") : @image-url("icons/instrument-wave.svg");
                        colorize: track.tint; image-fit: contain;
                    }
                    Rectangle {
                        x: 46px; y: 2px; width: root.header-width - (root.ui-density == 2 ? 142px : 122px); height: 27px;
                        background: name-touch.has-hover ? StudioTheme.hover : transparent; border-radius: 3px;
                        border-width: name-focus.has-focus ? 2px : 0px; border-color: StudioTheme.selection;
                        accessible-role: button; accessible-label: "Select track " + track.name;
                        accessible-action-default => { root.select-track-context(track.id); }
                        Text { x: 4px; width: parent.width - 8px; height: parent.height; text: track.name; color: StudioTheme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        name-focus := FocusScope {
                            width:0px;
                            changed has-focus => { if self.has-focus {root.focused-track-id=track.id;} else if root.focused-track-id==track.id {root.focused-track-id="";} }
                            key-pressed(event) => {
                                if event.text==Key.Space || event.text==Key.Return {root.select-track-context(track.id);return accept;}
                                if event.text==Key.F2 {root.inline-track-name=track.name;root.renaming-track-id=track.id;inline-name.focus();return accept;}
                                reject
                            }
                        }
                        name-touch := TouchArea {
                            double-clicked => { root.inline-track-name=track.name; root.renaming-track-id=track.id; inline-name.focus(); }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { name-focus.focus(); }
                                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.select-track-context(track.id); }
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { track-menu.show(); }
                            }
                            Tooltip { text:@markdown("Select track · double-click or press F2 to rename"); }
                        }
                        inline-name := LineEdit { visible:root.renaming-track-id==track.id; width:parent.width; height:parent.height;
                            text<=>root.inline-track-name; accepted=>{root.rename-track(track.id,self.text);root.renaming-track-id="";}
                            changed has-focus=>{if !self.has-focus && root.renaming-track-id==track.id {root.renaming-track-id="";}} }
                    }
                    track-menu := PopupWindow {
                        x: 28px; y: 28px; width: 170px; height: 150px; close-policy: close-on-click-outside;
                        Rectangle { background: #1a2938; border-width: 1px; border-color: #536b7f;
                            VerticalLayout { padding: 4px; spacing: 2px;
                                Button { text: "Select track"; clicked => { root.select-track-context(track.id); track-menu.close(); } }
                                Button { text: "Duplicate track"; enabled: root.track-items.length < root.track-limit; clicked => { root.duplicate-track(track.id); track-menu.close(); } }
                                Button { text: track.mute ? "Unmute" : "Mute"; clicked => { root.toggle-mute(track.id); track-menu.close(); } }
                                Button { text: track.solo ? "Unsolo" : "Solo"; clicked => { root.toggle-solo(track.id); track-menu.close(); } }
                                Button { text: "Remove track"; enabled: root.track-items.length > 1; clicked => { root.remove-track(track.id); track-menu.close(); } }
                            }
                        }
                    }
                    Text { x: 46px; y: 30px; width: root.header-width - 50px; height: 15px; text: track.instrument;
                        color: StudioTheme.secondary; font-size: 11px; overflow: elide; }
                    TrackStatus { x: root.ui-density == 2 ? 98px : 124px; y: root.ui-density == 2 ? 10px : 9px; width: root.ui-density == 2 ? 44px : 30px; height: root.ui-density == 2 ? 44px : 28px; label: "M"; checked: track.mute;
                        description: "Mute " + track.name; checked-color: StudioTheme.mute; activated => { root.toggle-mute(track.id); } }
                    TrackStatus { x: root.ui-density == 2 ? 144px : 156px; y: root.ui-density == 2 ? 10px : 9px; width: root.ui-density == 2 ? 44px : 30px; height: root.ui-density == 2 ? 44px : 28px; label: "S"; checked: track.solo;
                        description: "Solo " + track.name; checked-color: StudioTheme.solo; activated => { root.toggle-solo(track.id); } }
                }
                lane := Rectangle {
                    x: root.header-width; y: 0; width: parent.width - self.x; height: parent.height; clip: true;
                    background: track.selected ? #202a2d : StudioTheme.canvas;
                    for beat in root.arrangement-beat-count : Rectangle {
                        x: (beat + root.arrangement-first-beat) * root.arrangement-zoom * 1px + root.arrangement-x; y: 0; width: 1px; height: parent.height;
                        background: Math.mod(beat + root.arrangement-first-beat, 4) == 0 ? #4a5663 : #2b3540;
                    }
                    private property <float> context-beat;
                    private property <length> context-x;
                    private property <length> context-y;
                    empty-menu := PopupWindow {
                        x: lane.context-x; y: lane.context-y; width: 160px; height: 68px; close-policy: close-on-click-outside;
                        Rectangle { background: #1a2938; border-width: 1px; border-color: #536b7f;
                            VerticalLayout { padding: 4px; spacing: 2px;
                                Button { text: "New clip here"; clicked => { root.new-clip(track.id, lane.context-beat); empty-menu.close(); } }
                                Button { text: "Select track"; clicked => { root.select-track-context(track.id); empty-menu.close(); } }
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: root.middle-pan-target==1 ? grabbing : default;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { lane.context-beat = max(0,round((self.mouse-x - root.arrangement-x)/1px/root.arrangement-zoom*4)/4); lane.context-x = self.mouse-x; lane.context-y = self.mouse-y; empty-menu.show(); }
                            if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {root.begin-middle-pan(1,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                            if (event.kind==PointerEventKind.up && event.button==PointerEventButton.middle) || event.kind==PointerEventKind.cancel {root.end-middle-pan();}
                        }
                        moved => {if root.middle-pan-target==1 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}}
                        clicked => { root.select-track-context(track.id); }
                        double-clicked => {root.new-clip(track.id,max(0,round((self.mouse-x - root.arrangement-x)/1px/root.arrangement-zoom*4)/4));}
                        scroll-event(event) => {
                            if event.modifiers.control && event.delta-y != 0px { root.arrangement-zoom-at(event.delta-y > 0px ? 1.12 : 1/1.12,self.mouse-x/1px); return accept; }
                            if event.delta-x != 0px { root.arrangement-x += event.delta-x; root.clamp-scroll(); return accept; }
                            reject
                        }
                    }
                    for clip in track.clips : Rectangle {
                        x: clip.start * root.arrangement-zoom * 1px + root.arrangement-x; y: 7px;
                        width: max(4px, clip.length * root.arrangement-zoom * 1px - 2px); height: parent.height - 14px;
                        opacity: root.clip-drag-id==clip.id && root.clip-dragging ? 0.35 : 1;
                        private property <bool> editor-active: root.track-id == track.id && root.clip-id == clip.id;
                        border-radius: 3px; background: track.audible ? track.tint.with-alpha(clip.selected ? 0.26 : 0.16) : track.tint.with-alpha(0.10);
                        border-width: self.editor-active || clip.selected ? 2px : 1px;
                        border-color: self.editor-active ? StudioTheme.selection : clip.selected ? StudioTheme.solo : track.tint.with-alpha(0.65);
                        Rectangle { x: max(0px,parent.width - 8px); y: 4px; width: parent.editor-active ? 4px : 0px; height: 4px; border-radius: 1px; background: StudioTheme.selection; }
                        Text { x: 8px; y: 3px; width: max(0px,parent.width - 20px); height: 17px; text: clip.name; color: StudioTheme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                        Rectangle {
                            x: 5px; y: 22px; width: max(0px, parent.width - 10px); height: max(0px,parent.height - 26px); clip: true;
                            for note in clip.notes : Rectangle {
                                x: note.x * parent.width; y: note.y * parent.height;
                                width: max(1px, note.w * parent.width - 1px); height: max(2px, note.h * parent.height);
                                background: track.tint; opacity: track.audible ? 1 : 0.55;
                            }
                        }
                        private property <length> menu-x;
                        private property <length> menu-y;
                        clip-menu := PopupWindow {
                            x: parent.menu-x; y: parent.menu-y; width: 160px; height: 96px; close-policy: close-on-click-outside;
                            Rectangle { background: #1a2938; border-width: 1px; border-color: #536b7f;
                                VerticalLayout { padding: 4px; spacing: 2px;
                                    Button { text: "Edit clip"; clicked => { root.activate-editor-clip(track.id,clip.id); clip-menu.close(); } }
                                    Button { text: "Duplicate clip"; clicked => { root.duplicate-clip(track.id,clip.id); clip-menu.close(); } }
                                    Button { text: "Remove clip"; clicked => { root.remove-clip(track.id,clip.id); clip-menu.close(); } }
                                }
                            }
                        }
                        clip-touch := TouchArea {
                            mouse-cursor: root.middle-pan-target==1 ? grabbing : self.mouse-x>self.width - 9px ? ew-resize : grab;
                            pointer-event(event) => {
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.right { parent.menu-x=self.mouse-x; parent.menu-y=self.mouse-y; clip-menu.show(); }
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {root.begin-middle-pan(1,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                                if (event.kind==PointerEventKind.up && event.button==PointerEventButton.middle) || event.kind==PointerEventKind.cancel {root.end-middle-pan();}
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {
                                    clip-focus.focus();root.clip-drag-id=clip.id;root.clip-drag-track=track.id;
                                    root.clip-pointer-x=self.absolute-position.x/1px+self.mouse-x/1px;
                                    root.clip-pointer-y=self.absolute-position.y/1px+self.mouse-y/1px;
                                    root.clip-press-beat=(root.clip-pointer-x - root.rows-x - root.header-size - root.arrangement-x/1px)/root.arrangement-zoom;
                                    root.clip-press-y=root.clip-pointer-y;root.clip-base-start=clip.start;root.clip-base-length=clip.length;
                                    root.clip-preview-start=clip.start;root.clip-preview-length=clip.length;
                                    root.clip-target-index=index;root.clip-resizing=self.mouse-x>self.width - 9px;root.clip-dragging=false;
                                }
                                if event.kind==PointerEventKind.up && event.button==PointerEventButton.left && root.clip-drag-id==clip.id {
                                    if root.clip-dragging {
                                        if root.clip-resizing {root.resize-clip(track.id,clip.id,root.clip-preview-length);}
                                        else {root.move-clip(track.id,clip.id,root.track-items[root.clip-target-index].id,root.clip-preview-start);}
                                    } else {root.select-clip-context(track.id,clip.id);}
                                    root.clip-drag-id="";root.clip-dragging=false;
                                }
                                if event.kind==PointerEventKind.cancel {root.clip-drag-id="";root.clip-dragging=false;}
                            }
                            moved => {
                                if root.middle-pan-target==1 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                                if self.pressed && root.clip-drag-id==clip.id {
                                    root.clip-pointer-x=self.absolute-position.x/1px+self.mouse-x/1px;
                                    root.clip-pointer-y=self.absolute-position.y/1px+self.mouse-y/1px;root.update-clip-drag();
                                }
                            }
                            Tooltip {text:@markdown("Drag to move · right edge to resize · snap 1/16");}
                            scroll-event(event) => {
                                if event.modifiers.control && event.delta-y != 0px { root.arrangement-zoom-at(event.delta-y > 0px ? 1.12 : 1/1.12,(self.absolute-position.x+ self.mouse-x)/1px - root.rows-x - root.header-size); return accept; }
                                if event.delta-x != 0px { root.arrangement-x += event.delta-x; root.clamp-scroll(); return accept; }
                                reject
                            }
                        }
                    }
                    if root.project-position * root.arrangement-zoom * 1px + root.arrangement-x >= 0px : Rectangle {
                        x: root.project-position * root.arrangement-zoom * 1px + root.arrangement-x; y: 0; width: 1px; height: parent.height; background: #edf8ff;
                    }
                }
                Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: StudioTheme.border; }
            }
            if root.clip-dragging : Rectangle {
                x:root.header-width;y:0;width:rows.visible-width - self.x;height:rows.content-height;clip:true;
                Rectangle {
                    x:root.clip-preview-start*root.arrangement-zoom*1px+root.arrangement-x;
                    y:root.clip-target-index*root.row-height+7px;
                    width:max(4px,root.clip-preview-length*root.arrangement-zoom*1px - 2px);height:root.row-height - 14px;
                    background:#79dfb94d;border-width:2px;border-color:#efffd8;border-radius:4px;
                    Text {x:6px;y:4px;text:root.clip-resizing ? "Resize · "+root.clip-preview-length+" beats" : "Move · beat "+(root.clip-preview-start+1);color:#efffd8;}
                }
            }
            if root.dragging && root.drop-index >= 0 : Rectangle {
                x: 0; y: (root.drop-index + (root.drop-index > root.drag-index ? 1 : 0)) * root.row-height; width: rows.visible-width; height: 3px; background: #ffe39b;
            }
        }
        }
        horizontal := ScrollView {
            x: root.header-width; y: root.toolbar-height + 26px + root.arrangement-height; width: parent.width - self.x - 12px; height: 18px;
            // Keep the end of even a short project reachable by panning.
            min-height: 18px; content-width: max(self.visible-width, root.project-beats * root.arrangement-zoom * 1px + self.visible-width);
            content-height: self.visible-height; content-x <=> root.arrangement-x;
            horizontal-scrollbar-policy: always-on; vertical-scrollbar-policy: always-off;
        }
        Rectangle {
            x: 0; y: root.toolbar-height + 44px + root.arrangement-height; width: parent.width; height: root.splitter-height;
            background: StudioTheme.app;
            Rectangle { x: (parent.width - 48px)/2; y: 5px; width: 48px; height: 2px; border-radius: 1px; background: split-touch.has-hover || split-touch.pressed ? StudioTheme.accent : #687685; }
            split-touch := TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    if self.pressed {
                        root.workspace-focus = 0;
                        root.workspace-split = max(100px, min(root.max-arrangement-height, self.absolute-position.y + self.mouse-y - main.absolute-position.y - root.toolbar-height - 44px)) / root.max-arrangement-height;
                    }
                }
                double-clicked => { root.workspace-focus = 0; root.workspace-split = -1; }
                Tooltip { text: @markdown("Drag to resize editors · double-click for adaptive layout"); }
            }
        }
        // One compact editor toolbar: clip identity, edit commands and view controls.
        Rectangle { x:0; y:root.toolbar-height+56px+root.arrangement-height; width:parent.width; height:root.editor-toolbar-height; background:StudioTheme.panel; }
        HorizontalLayout {
            x:0; y:root.toolbar-height+56px+root.arrangement-height; width:parent.width; height:root.editor-toolbar-height; spacing:3px;
            new-clip-button := StudioIconButton { icon:@image-url("icons/add.svg"); label:"New clip"; clicked=>{root.new-clip(root.track-id,root.clip-id!="0" ? root.clip-start-beat+root.clip-length-beats : root.project-position);} }
            dup-clip-button := StudioIconButton { icon:@image-url("icons/copy.svg"); label:"Duplicate clip"; enabled:root.clip-id!="0"; clicked=>{root.duplicate-clip(root.track-id,root.clip-id);} }
            remove-clip-button := StudioIconButton { icon:@image-url("icons/remove.svg"); label:"Remove clip"; enabled:root.clip-id!="0"; clicked=>{root.remove-clip(root.track-id,root.clip-id);} }
            ComboBox { width:100px; model:root.clip-names; current-index<=>root.clip-index; enabled:root.clip-id!="0";
                selected(value)=>{if self.current-index>=0 && self.current-index<root.clip-ids.length {root.activate-editor-clip(root.track-id,root.clip-ids[self.current-index]);}} }
            undo-button := StudioIconButton { icon:@image-url("icons/undo.svg"); label:"Undo"; enabled:root.can-undo; clicked=>{root.undo();} }
            StudioIconButton { icon:@image-url("icons/redo.svg"); label:"Redo"; enabled:root.can-redo; clicked=>{root.redo();} }
            StudioIconButton { icon:@image-url("icons/delete.svg"); label:"Delete selected notes"; hint:"Delete selected notes · Delete"; enabled:root.selected-note-id!="0"; clicked=>{root.remove-note();} }
            StudioIconButton { icon:@image-url("icons/fit.svg"); label:"Fit notes"; clicked=>{root.fit-notes();} }
            Button { width:64px; text:"Restore"; clicked=>{root.restore-view();} Tooltip {text:@markdown("Restore view before Fit");} }
            Button { width:38px; text:"Vel"; accessible-label:"Toggle velocity lane"; checked:root.velocity-visible; clicked=>{root.velocity-visible=!root.velocity-visible;} Tooltip {text:@markdown("Toggle velocity lane");} }
            midi-snap-control := ComboBox { width:80px; model:["Off", "1/4", "1/16", "1/32"]; current-index:root.snap-index; selected(value)=>{root.set-snap(self.current-index);} }
            midi-view-control := ComboBox { width:80px; model: root.is-drums ? ["Piano", "Used", "Drum"] : ["Piano", "Used"]; current-index:root.midi-view-mode;
                selected(value)=>{root.set-midi-view-mode(self.current-index);} }
            ref-control := Rectangle {
                width:60px; height:root.editor-toolbar-height;
                Button { text:"Refs " + root.reference-count; clicked=>{ref-menu.show();} Tooltip {text:@markdown("MIDI references");} }
                ref-menu := PopupWindow {
                    x:-260px; y:root.editor-toolbar-height; width:400px; height:260px; close-policy:close-on-click-outside;
                    Rectangle { background:#1a2938; border-width:1px; border-color:#536b7f;
                        HorizontalLayout { x:5px;y:5px;width:parent.width - 10px;height:28px;spacing:4px;
                            Button { text:root.follow-selection ? "Follow selection" : "Editor locked"; checked:root.follow-selection; clicked=>{root.follow-selection-changed(!root.follow-selection);} }
                            Button { text:"Hide references"; clicked=>{root.hide-references();} }
                        }
                        ScrollView { x:5px;y:37px;width:parent.width - 10px;height:parent.height - 42px;
                            content-width:self.visible-width; content-height:max(self.visible-height, root.reference-items.length * 32px);
                            for item[index] in root.reference-items : Rectangle {
                                x:0;y:index*32px;width:parent.width;height:30px;
                                HorizontalLayout { spacing:3px;
                                    CheckBox { width:170px; text:item.label; checked:item.visible; enabled:!item.active; toggled=>{root.toggle-reference(item.track-id,item.clip-id);} }
                                    Button { width:58px; text:item.pinned ? "Unpin" : "Pin"; checked:item.pinned; enabled:!item.active; clicked=>{root.toggle-reference-pin(item.track-id,item.clip-id);} }
                                    Button { width:50px; text:item.active ? "Active" : "Edit"; enabled:!item.active; clicked=>{root.activate-editor-clip(item.track-id,item.clip-id); ref-menu.close();} }
                                }
                            }
                        }
                    }
                }
            }
            zoom-control := Rectangle {
                width:44px; height:root.editor-toolbar-height;
                Button { text:"Zoom"; clicked=>{zoom-menu.show();} }
                zoom-menu := PopupWindow {
                    x:-108px; y:root.editor-toolbar-height; width:160px; height:160px; close-policy:close-on-click-outside;
                    Rectangle { background:#1a2938; border-width:1px; border-color:#536b7f;
                        VerticalLayout { padding:4px; spacing:2px;
                            Button { text:"Horizontal −"; clicked=>{root.zoom(0.8);} }
                            Button { text:"Horizontal +"; clicked=>{root.zoom(1.25);} }
                            Button { text:"Vertical −"; clicked=>{root.zoom-y(0.8);} }
                            Button { text:"Vertical +"; clicked=>{root.zoom-y(1.25);} }
                            Button { text:root.navigation-linked ? "Unlink timeline" : "Link timeline"; checked:root.navigation-linked; clicked=>{root.set-navigation-linked(!root.navigation-linked);} }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch:1; }
        }
        editor := Rectangle {
            visible: root.workspace-focus != 1;
            x:0;y:root.toolbar-height+58px+root.editor-toolbar-height+root.arrangement-height;width:parent.width;height:max(0px, parent.height - self.y);
            // The editor can be locked to a different track than the selected
            // arrangement row: its notes follow the editor's track identity.
            private property <color> note-tint: root.track-index >= 0 && root.track-index < root.track-items.length ? root.track-items[root.track-index].tint : StudioTheme.accent;
            private property <bool> note-tint-dark: (editor.note-tint.red * 299 + editor.note-tint.green * 587 + editor.note-tint.blue * 114) / 1000 < 135;
            Rectangle {x:0;y:0px;width:root.keyboard-width;height:20px;background:StudioTheme.panel;
                Text {text:root.is-drums ? "DRUMS / MIDI" : "KEY / MIDI";color:StudioTheme.secondary;font-size:10px;horizontal-alignment:center;vertical-alignment:center;}}
            Rectangle {
                x:root.keyboard-width;y:0px;width:parent.width - self.x - 12px;height:20px;background:StudioTheme.panel;clip:true;
                for beat in root.piano-beat-count : Text {
                    x:(beat+root.piano-first-beat - root.display-scroll-beat)*root.pixels-per-beat*1px+3px;y:3px;
                    text:beat+root.piano-first-beat+1;color:StudioTheme.secondary;font-size:11px;
                }
                TouchArea {
                    mouse-cursor: root.middle-pan-target==2 ? grabbing : default;
                    clicked=>{root.seek(root.display-scroll-beat+self.mouse-x/1px/root.pixels-per-beat);}
                    pointer-event(event)=>{
                        if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {root.begin-middle-pan(2,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                        if (event.kind==PointerEventKind.up && event.button==PointerEventButton.middle) || event.kind==PointerEventKind.cancel {root.end-middle-pan();}
                    }
                    moved=>{if root.middle-pan-target==2 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}}
                }
            }
            piano-focus := FocusScope {
                x:0;y:21px;width:parent.width - 12px;height:max(80px,parent.height - 74px - (root.velocity-visible ? 60px : 0px));
                focus-lost(reason)=>{root.release-audition();root.cancel-note();}
                key-pressed(event) => {
                    if event.modifiers.control && (event.text == "z" || event.text == "Z") {
                        if event.modifiers.shift { root.redo(); } else { root.undo(); }
                        return accept;
                    }
                    if event.modifiers.control && (event.text == "y" || event.text == "Y") { root.redo(); return accept; }
                    if event.text == Key.Delete || event.text == Key.Backspace { if root.selected-note-id != "0" { root.remove-note(); } return accept; }
                    if event.text == Key.Escape { root.cancel-interactions(); return accept; }
                    reject
                }
                keyboard := Rectangle {
                    x:0;y:0;width:root.keyboard-width;height:parent.height;clip:true;background:#adb9c4;
                    for key in root.key-items : Rectangle {
                        x:0;y:key.y*1px+root.piano-scene-offset-y;width:parent.width;height:key.h*1px;
                        background:key-touch.pressed ? StudioTheme.accent : key.black ? #27333f : key.c ? #d3dfe9 : #afbbc7;
                        Rectangle {x:0;y:0;width:key.c ? 3px : 0px;height:parent.height;background:StudioTheme.accent;}
                        Rectangle {x:0;y:parent.height - 1px;width:parent.width;height:1px;background:key.black ? #1b252f : #8796a4;}
                        Text {x:7px;y:0;width:parent.width - 13px;height:parent.height;text:key.label;
                            color:key-touch.pressed ? #17251e : key.black ? StudioTheme.text : #16202b;font-size:key.h>=22 ? 12px : 11px;font-weight:key.c ? 700 : 400;vertical-alignment:center;horizontal-alignment:root.is-drums ? left : right;overflow:elide;}
                        key-touch := TouchArea {
                            accessible-role:button;accessible-label:key.label+" · MIDI "+key.pitch;
                            mouse-cursor: root.middle-pan-target==2 ? grabbing : default;
                            pointer-event(event)=>{
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {piano-focus.focus();root.key-gate(key.pitch,true);}
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {root.begin-middle-pan(2,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                                if event.kind==PointerEventKind.up && event.button==PointerEventButton.middle {root.end-middle-pan();}
                                if (event.kind==PointerEventKind.up && event.button==PointerEventButton.left) || event.kind==PointerEventKind.cancel {root.key-gate(key.pitch,false);}
                                if event.kind==PointerEventKind.cancel {root.end-middle-pan();}
                            }
                            moved=>{if root.middle-pan-target==2 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);} else if self.pressed && (self.mouse-x<0px || self.mouse-x>=self.width || self.mouse-y<0px || self.mouse-y>=self.height) {root.release-audition();}}
                            scroll-event(event)=>{if event.modifiers.control && event.delta-y != 0px { if event.modifiers.shift {root.zoom-y(event.delta-y > 0px ? 1.12 : 1/1.12);} else {root.zoom-at(event.delta-y > 0px ? 1.12 : 1/1.12,root.canvas-width/2);} } else {root.piano-wheel(event.delta-x/1px,event.delta-y/1px);} accept}
                            Tooltip {text:@markdown("\{key.label} · MIDI \{key.pitch}");}
                        }
                    }
                }
                grid := Rectangle {
                    x:root.keyboard-width;y:0;width:parent.width - self.x;height:parent.height;background:StudioTheme.canvas;clip:true;
                    for key in root.key-items : Rectangle {
                        x:0;y:key.y*1px+root.piano-scene-offset-y;width:parent.width;height:key.h*1px;background:root.scale-mode != 0 && key.in-scale ? #253632 : key.black ? #171d24 : #1b222a;
                        Rectangle {x:0;y:parent.height - 1px;height:1px;width:parent.width;background:key.c ? #4b5968 : #27313b;}
                    }
                    for line in root.piano-beat-count*4+4 : Rectangle {
                        x:((line+root.piano-first-line)/4 - root.display-scroll-beat)*root.pixels-per-beat*1px;y:0;width:1px;height:parent.height;
                        background:Math.mod(line+root.piano-first-line,16)==0 ? #4a5663 : Math.mod(line+root.piano-first-line,4)==0 ? #34404b : #252e37;
                    }
                    Rectangle {x:root.clip-length-beats*root.pixels-per-beat*1px - root.display-scroll-beat*root.pixels-per-beat*1px;y:0;width:max(0px,parent.width - self.x);height:parent.height;background:#070c13b0;}
                    for ghost in root.ghost-items : Rectangle {
                        x:ghost.x*1px+root.piano-scene-offset-x; y:ghost.y*1px+root.piano-scene-offset-y; width:ghost.w*1px; height:ghost.h*1px;
                        background:ghost.tint.with-alpha(0.07); border-width:1px; border-color:ghost.tint.with-alpha(0.80); border-radius:2px;
                    }
                    for note in root.note-items : Rectangle {
                        x:note.x*1px+root.piano-scene-offset-x;y:note.y*1px+root.piano-scene-offset-y;width:note.w*1px;height:note.h*1px;
                        background:editor.note-tint;border-radius:2px;
                        border-width: note.selected ? 2px : editor.note-tint-dark ? 1px : 0px; border-color: note.selected ? StudioTheme.selection : StudioTheme.secondary;
                        if note.w >= 28 : Text {x:3px;y:0;width:parent.width - 5px;height:parent.height;text:note.label;color:editor.note-tint-dark ? StudioTheme.selection : #10201a;font-size:11px;font-weight:600;vertical-alignment:center;overflow:elide;}
                    }
                    if root.playhead-x>=0 && root.playhead-x<root.canvas-width : Rectangle {
                        x:root.playhead-x*1px - 1px;y:0;width:3px;height:parent.height;background:StudioTheme.app;
                        Rectangle {x:1px;y:0;width:1px;height:parent.height;background:StudioTheme.selection;}
                    }
                    private property <length> menu-x;
                    private property <length> menu-y;
                    private property <length> menu-action-height: 32px;
                    private property <length> popup-width: 180px;
                    private property <length> popup-height: 5 * grid.menu-action-height + 16px;
                    private property <length> popup-x: max(-grid.absolute-position.x, min(grid.menu-x, root.width - grid.absolute-position.x - grid.popup-width));
                    private property <length> popup-y: max(-grid.absolute-position.y, min(grid.menu-y, root.height - grid.absolute-position.y - grid.popup-height));
                    private property <string> menu-track-id;
                    private property <string> menu-clip-id;
                    piano-menu := PopupWindow {
                        // Keep the menu inside the window without changing the clicked note position.
                        x: grid.popup-x; y: grid.popup-y;
                        width: grid.popup-width; height: grid.popup-height; close-policy: close-on-click-outside;
                        Rectangle { background: StudioTheme.raised; border-width: 1px; border-color: #576675;
                            VerticalLayout { padding: 4px; spacing: 2px;
                                Button { height: grid.menu-action-height; text: "Note inspector"; clicked => { root.inspector-visible=true; root.project-tab=false; root.sound-tab=false; root.inspector-detail=2; root.inspector-scroll=0px; piano-menu.close(); } }
                                Button { height: grid.menu-action-height; text: "Delete note here"; enabled:root.selected-note-id!="0"; clicked => {root.delete-note-at(grid.menu-track-id,grid.menu-clip-id,grid.menu-x/1px,grid.menu-y/1px);piano-menu.close();} }
                                Button { height: grid.menu-action-height; text: "Fit notes"; clicked => { root.fit-notes(); piano-menu.close(); } }
                                Button { height: grid.menu-action-height; text: "Restore view"; clicked => { root.restore-view(); piano-menu.close(); } }
                                Button { height: grid.menu-action-height; text: root.velocity-visible ? "Hide velocity" : "Show velocity"; clicked => { root.velocity-visible=!root.velocity-visible; piano-menu.close(); } }
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: root.middle-pan-target==2 ? grabbing : default;
                        double-clicked => {root.double-click-note();}
                        pointer-event(event)=>{
                            if event.kind==PointerEventKind.down && event.button==PointerEventButton.middle {
                                root.begin-middle-pan(2,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);
                            } else if event.kind==PointerEventKind.down && (event.button==PointerEventButton.left || event.button==PointerEventButton.right) {
                                piano-focus.focus();if root.inspector-visible && !root.sound-tab && !root.project-tab {root.inspector-detail=2;root.inspector-scroll=0px;}
                                if event.button==PointerEventButton.right {grid.menu-track-id=root.track-id;grid.menu-clip-id=root.clip-id;grid.menu-x=self.mouse-x;grid.menu-y=self.mouse-y;}
                                root.down(self.mouse-x/1px,self.mouse-y/1px,event.button==PointerEventButton.right,event.modifiers.shift || event.modifiers.control);
                                if event.button==PointerEventButton.right {piano-menu.show();}
                            }
                            if event.kind==PointerEventKind.up && event.button==PointerEventButton.middle {root.end-middle-pan();}
                            else if event.kind==PointerEventKind.up && (event.button==PointerEventButton.left || event.button==PointerEventButton.right) {root.up(self.mouse-x/1px,self.mouse-y/1px);}
                            if event.kind==PointerEventKind.cancel {root.end-middle-pan();root.cancel-note();}
                        }
                        moved=>{
                            if root.middle-pan-target==2 {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
                            else if self.pressed {root.moved(self.mouse-x/1px,self.mouse-y/1px);}
                        }
                        scroll-event(event)=>{if event.modifiers.control && event.delta-y != 0px { if event.modifiers.shift {root.zoom-y(event.delta-y > 0px ? 1.12 : 1/1.12);} else {root.zoom-at(event.delta-y > 0px ? 1.12 : 1/1.12,self.mouse-x/1px);} } else {root.piano-wheel(event.delta-x/1px,event.delta-y/1px);} accept}
                    }
                }
            }
            if root.velocity-visible : VelocityLane {
                x: root.keyboard-width; y: piano-focus.y + piano-focus.height;
                width: parent.width - self.x - 12px; height: 60px;
                items: root.velocity-items;
                tint: editor.note-tint;
                scroll-offset-x: root.piano-scene-offset-x;
                middle-pan-active: root.middle-pan-target==2;
                middle-pan-start(x,y) => {root.begin-middle-pan(2,x,y);}
                middle-pan-move(x,y) => {root.move-middle-pan(x,y);}
                middle-pan-end() => {root.end-middle-pan();}
                wheel(dx,dy,control,shift,x) => {
                    if control && dy != 0 {
                        if shift {root.zoom-y(dy > 0 ? 1.12 : 1/1.12);}
                        else {root.zoom-at(dy > 0 ? 1.12 : 1/1.12,max(0,min(root.canvas-width,x)));}
                    } else {root.piano-wheel(dx,dy);}
                }
                select-note(id) => { if root.inspector-visible && !root.sound-tab && !root.project-tab { root.inspector-detail = 2; root.inspector-scroll = 0px; } root.select-velocity-note(id); }
                change-value(id,value) => { root.set-velocity-note(id,value); }
            }
            ScrollView {
                x:parent.width - 12px;y:piano-focus.y;width:12px;min-width:12px;height:piano-focus.height;
                content-width:self.visible-width;content-height:root.piano-row-count*root.piano-row-height*1px;content-y<=>root.piano-bar-y;
                horizontal-scrollbar-policy:always-off;vertical-scrollbar-policy:always-on;
                scrolled=>{root.scroll-piano(-root.piano-bar-x/1px/root.pixels-per-beat,-self.content-y/1px);}
            }
            ScrollView {
                x:root.keyboard-width;y:piano-focus.y+piano-focus.height+(root.velocity-visible ? 60px : 0px);width:parent.width - self.x - 12px;height:16px;min-height:16px;
                content-width:max(self.visible-width,root.clip-length-beats*root.pixels-per-beat*1px);content-height:self.visible-height;content-x<=>root.piano-bar-x;
                horizontal-scrollbar-policy:always-on;vertical-scrollbar-policy:always-off;
                scrolled=>{root.scroll-piano(-self.content-x/1px/root.pixels-per-beat,-root.piano-bar-y/1px);}
            }
            HorizontalLayout {
                x:0;y:parent.height - root.velocity-control-height - 1px;width:parent.width;height:root.velocity-control-height;spacing:5px;
                Text {text:root.selected-label;color:StudioTheme.secondary;font-size:11px;overflow:elide;horizontal-stretch:1;vertical-alignment:center;}
                Text {text:"Velocity";color:StudioTheme.secondary;vertical-alignment:center;font-size:11px;}
                SpinBox {width:root.velocity-control-width;value<=>root.note-velocity;minimum:1;maximum:127;enabled:root.selected-note-id!="0";edited(value)=>{root.velocity(value);}}
            }
        }
    }
    inspector := Rectangle {
        x: root.width - root.inspector-width - 6px; y: 44px; width: root.inspector-width; height: root.height - 70px;
        visible: root.inspector-visible; background: StudioTheme.panel; border-radius: 5px;
        // Consume input over empty and disabled inspector regions so it never
        // reaches the timeline or piano roll underneath an overlaid panel.
        TouchArea {
            scroll-event(event) => {
                root.inspector-scroll = min(0px,max(min(0px,inspector-scroll-view.visible-height - inspector-scroll-view.content-height),root.inspector-scroll + event.delta-y));
                accept
            }
        }
        HorizontalLayout {
            x: 10px; y: 6px; width: parent.width - 20px; height: 30px; spacing: 5px;
            inspector-track := Button { text: "Track"; checked: !root.project-tab && !root.sound-tab && root.inspector-detail == 0; clicked => { root.project-tab = false; root.sound-tab = false; root.inspector-detail = 0; root.inspector-scroll = 0px; } }
            sound-tab-button := Button { text: "Sound"; checked: root.sound-tab && !root.project-tab; clicked => { root.project-tab = false; root.sound-tab = true; root.inspector-scroll = 0px; } }
            Button { text: "Project"; checked: root.project-tab; clicked => { root.project-tab = true; root.sound-tab = false; root.inspector-scroll = 0px; } }
        }
        Button { x: parent.width - 75px; y:39px; width:36px; height:28px; text:"Pin"; checked:root.inspector-pinned;
            accessible-label: root.inspector-pinned ? "Unpin inspector" : "Pin inspector";
            clicked=>{root.inspector-pinned=!root.inspector-pinned;}
            Tooltip {text:root.inspector-overlaid && root.inspector-pinned ? @markdown("Pinned inspector is overlaid until the workspace is wider") : @markdown("Pin inspector as a side panel");} }
        inspector-close := Button { x: parent.width - 38px; y:39px; width:30px; height:28px; text:"×"; accessible-label:"Close inspector";
            clicked=>{root.inspector-visible=false;} Tooltip {text:@markdown("Close inspector");} }
        TouchArea { x:0; y:68px; width:10px; height:parent.height - 68px; mouse-cursor:ew-resize;
            moved=>{if self.pressed {root.inspector-custom-width=max(220,min(400,(root.width - self.absolute-position.x - self.mouse-x)/1px));}}
            Tooltip {text:@markdown("Drag to resize inspector");} }
        HorizontalLayout {
            x: 10px; y: 39px; width: parent.width - 90px; height: 28px; spacing: 5px;
            Button { text: "Clip"; checked: !root.project-tab && !root.sound-tab && root.inspector-detail == 1; clicked => { root.project-tab = false; root.sound-tab = false; root.inspector-detail = 1; root.inspector-scroll = 0px; } }
            Button { text: "Note"; checked: !root.project-tab && !root.sound-tab && root.inspector-detail == 2; clicked => { root.project-tab = false; root.sound-tab = false; root.inspector-detail = 2; root.inspector-scroll = 0px; } }
        }
        inspector-scroll-view := ScrollView {
            x: 12px; y: 74px; width: parent.width - 24px; height: parent.height - 86px;
            horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
            content-height: root.project-tab ? 460px : root.sound-tab ? (root.is-drums ? 1100px : 710px) : root.inspector-detail == 0 ? 810px : 240px;
            content-y <=> root.inspector-scroll;
            VerticalLayout {
                visible: !root.project-tab && !root.sound-tab && root.inspector-detail == 0;
                x: 0; y: 0; width: parent.width - 8px; height: 810px; spacing: 7px;
                Text { height: 18px; text: "SELECTED TRACK  ·  " + (root.inspector-track-index + 1); color: StudioTheme.accent; font-size: 11px; }
                name-edit := LineEdit { height: 30px; text <=> root.inspector-track-name-draft; accepted => { root.rename-track(root.inspector-track-id, self.text); } }
                Button { height: 28px; text: "Rename"; clicked => { root.rename-track(root.inspector-track-id, name-edit.text); } }
                ComboBox { height: 30px; model: ["Mint", "Blue", "Amber", "Violet", "Rose", "Cyan"]; current-index <=> root.inspector-color-index;
                    selected(value) => { root.color-track(root.inspector-track-id, self.current-index); } }
                Text { height: 18px; text: root.inspector-instrument + "  ·  independent instance"; color: StudioTheme.secondary; font-size: 10px; }
                Text { height: 18px; text: "Output → Master"; color: StudioTheme.text; }
                HorizontalLayout {
                    height: 30px; spacing: 5px;
                    inspector-mute := Button { text: "Mute"; accessible-checkable: true; accessible-checked: root.inspector-muted; checked: root.inspector-muted;
                        clicked => { root.toggle-mute(root.inspector-track-id); } }
                    Button { text: "Solo"; accessible-checkable: true; accessible-checked: root.inspector-soloed; checked: root.inspector-soloed;
                        clicked => { root.toggle-solo(root.inspector-track-id); } }
                }
                Text { height: 18px; text: root.inspector-audible ? "Audible · solo is cumulative" : root.inspector-muted ? "Muted · fader value retained" : "Excluded by another solo";
                    color: root.inspector-audible ? StudioTheme.accent : StudioTheme.mute; font-size: 10px; }
                Text { height: 18px; text: "Volume  " + round(root.inspector-gain * 100) + "%"; color: StudioTheme.text; }
                gain-slider := Slider { height: 26px; value <=> root.inspector-gain; minimum: 0; maximum: 2;
                    changed(value) => { root.set-gain(root.inspector-track-id, value); } released(value) => { root.finish-mix(); } }
                Text { height: 18px; text: "Pan  " + round(root.inspector-pan * 100); color: StudioTheme.text; }
                Slider { height: 26px; value <=> root.inspector-pan; minimum: -1; maximum: 1;
                    changed(value) => { root.set-pan(root.inspector-track-id, value); } released(value) => { root.finish-mix(); } }
                Text { height: 18px; text: root.mix-label; color: StudioTheme.tertiary; font-size: 10px; }
                HorizontalLayout {
                    height: 30px; spacing: 4px;
                    Button { text: "↑"; accessible-label: "Move track up"; enabled: root.inspector-track-index > 0; clicked => { root.move-track(root.inspector-track-id, -1); } Tooltip { text: @markdown("Move track up"); } }
                    Button { text: "↓"; accessible-label: "Move track down"; enabled: root.inspector-track-index < root.track-items.length - 1; clicked => { root.move-track(root.inspector-track-id, 1); } Tooltip { text: @markdown("Move track down"); } }
                    Button { text: "Remove"; enabled: root.track-items.length > 1; clicked => { root.remove-track(root.inspector-track-id); } }
                }
                Text { height: 30px; text: "Drag ≡ to reorder tracks.\nTrack / note edits stop playback."; color: StudioTheme.tertiary; font-size: 10px; }
                Rectangle { height: 1px; background: StudioTheme.border; }
                Button { height: 30px; text: "Use oscillator instrument"; enabled: !root.inspector-is-synth; clicked => { root.use-sine(root.inspector-track-id); } }
                Button {height:30px;text:"Use CC0 drum kit";enabled:!root.inspector-is-drums;clicked=>{root.use-drums(root.inspector-track-id);if root.inspector-track-id==root.track-id {root.sound-tab=true;}root.inspector-scroll=0px;}}
                sample-file := LineEdit { height: 30px; text <=> root.inspector-sample-path; placeholder-text: "Path to short WAV sample"; }
                HorizontalLayout {
                    height: 30px;
                    Text { text: "Root MIDI"; color: StudioTheme.text; vertical-alignment: center; }
                    root-note := SpinBox { minimum: 0; maximum: 127; value <=> root.inspector-sample-root; }
                }
                one-shot := CheckBox { height: 26px; text: "One-shot"; checked <=> root.inspector-sample-one-shot; }
                Button { height: 30px; text: "Load WAV into this track";
                    clicked => { root.import-sample(root.inspector-track-id, sample-file.text, root-note.value, one-shot.checked); } }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                visible: !root.project-tab && !root.sound-tab && root.inspector-detail == 1;
                x: 0; y: 0; width: parent.width - 8px; height: 240px; spacing: 6px;
                editor-clip-label := Text { height: 22px; text: "EDITOR CLIP · " + root.track-name + (root.clip-id != "0" && root.clip-index >= 0 && root.clip-index < root.clip-names.length ? " › " + root.clip-names[root.clip-index] : ""); color: StudioTheme.accent; overflow: elide; }
                LineEdit { height: 30px; text <=> root.clip-name-draft; enabled: root.clip-id != "0"; placeholder-text: "Clip name"; accepted => { root.rename-clip(root.track-id, root.clip-id, self.text); } }
                Text { height: 22px; text: root.clip-id == "0" ? "No clip selected" : "Start " + (root.clip-start-beat + 1) + " · " + root.clip-length-beats + " beats"; color: StudioTheme.text; }
                Button { height: 30px; text: "Duplicate clip"; enabled: root.clip-id != "0"; clicked => { root.duplicate-clip(root.track-id,root.clip-id); } }
                Button { height: 30px; text: "Remove clip"; enabled: root.clip-id != "0"; clicked => { root.remove-clip(root.track-id,root.clip-id); } }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                visible: !root.project-tab && !root.sound-tab && root.inspector-detail == 2;
                x: 0; y: 0; width: parent.width - 8px; height: 240px; spacing: 6px;
                Text { height: 22px; text: "SELECTED NOTE"; color: StudioTheme.accent; }
                Text { height: 30px; text: root.selected-note-id == "0" ? "No note selected" : root.selected-label; color: StudioTheme.text; overflow: elide; }
                HorizontalLayout { height: root.velocity-control-height; Text { text: "Velocity"; color: StudioTheme.text; vertical-alignment: center; } SpinBox { width: root.velocity-control-width; value <=> root.note-velocity; minimum: 1; maximum: 127; enabled: root.selected-note-id != "0"; edited(value) => { root.velocity(value); } } }
                Button { height: 30px; text: "Delete note"; enabled: root.selected-note-id != "0"; clicked => { root.remove-note(); } }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                visible: root.sound-tab && !root.project-tab && !root.is-drums;
                x: 0; y: 0; width: parent.width - 8px; height: 710px; spacing: 7px;
                synth-sound-label := Text { height: 18px; text: "EDITOR SOUND  ·  " + root.track-name; color: StudioTheme.accent; overflow: elide; }
                Text { height: 18px; text: root.is-synth ? root.preset-label : "Sampler · controls in Track"; color: StudioTheme.text; overflow: elide; }
                HorizontalLayout {
                    height: 30px; spacing: 5px;
                    ComboBox { enabled: root.is-synth; model: ["Legacy Sine", "Warm Saw", "Hollow Pulse", "Soft Triangle", "Short Pluck"]; current-index <=> root.factory-index; }
                    preset-apply := Button { text: "Apply"; enabled: root.is-synth;
                        clicked => { root.factory-preset(root.track-id, root.instance-id, root.factory-index); } }
                }
                waveform-combo := ComboBox { height: 30px; enabled: root.is-synth; model: ["Sine", "Saw", "Square / PWM", "Triangle"]; current-index <=> root.synth-wave;
                    selected(value) => { root.synth-parameter(root.track-id, root.instance-id, 0, self.current-index); root.finish-mix(); } }
                Text { height: 18px; text: "Shape  " + round(root.synth-shape * 100) + "%  ·  sine → wave"; color: StudioTheme.text; }
                shape-slider := Slider { height: 26px; enabled: root.is-synth && root.synth-wave != 0; minimum: 0; maximum: 1; value <=> root.synth-shape;
                    changed(value) => { root.synth-parameter(root.track-id, root.instance-id, 1, value); } released(value) => { root.finish-mix(); } }
                Text { height: 18px; text: "Pulse width  " + round(root.synth-duty * 100) + "%"; color: StudioTheme.text; }
                duty-slider := Slider { height: 26px; enabled: root.is-synth && root.synth-wave == 2; minimum: 0.05; maximum: 0.95; value <=> root.synth-duty;
                    changed(value) => { root.synth-parameter(root.track-id, root.instance-id, 2, value); } released(value) => { root.finish-mix(); } }
                HorizontalLayout { height: 30px;
                    Text { text: "Attack · ms"; color: StudioTheme.text; vertical-alignment: center; }
                    attack-spin := SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 10000; value <=> root.synth-attack;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 3, value / 1000.0); root.finish-mix(); } }
                }
                HorizontalLayout { height: 30px;
                    Text { text: "Decay · ms"; color: StudioTheme.text; vertical-alignment: center; }
                    SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 10000; value <=> root.synth-decay;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 4, value / 1000.0); root.finish-mix(); } }
                }
                HorizontalLayout { height: 30px;
                    Text { text: "Sustain · %"; color: StudioTheme.text; vertical-alignment: center; }
                    SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 100; value <=> root.synth-sustain;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 5, value / 100.0); root.finish-mix(); } }
                }
                HorizontalLayout { height: 30px;
                    Text { text: "Release · ms"; color: StudioTheme.text; vertical-alignment: center; }
                    SpinBox { enabled: root.is-synth; width: 116px; minimum: 0; maximum: 20000; value <=> root.synth-release;
                        edited(value) => { root.synth-parameter(root.track-id, root.instance-id, 6, value / 1000.0); root.finish-mix(); } }
                }
                Text { height: 32px; text: "ADSR applies to new notes.\nWave / shape / PWM fade in 10 ms."; color: StudioTheme.secondary; font-size: 10px; }
                Text { height: 28px; text: "Volume / pan: Track tab.\nOne oscillator · independent voices."; color: StudioTheme.secondary; font-size: 10px; }
                Rectangle { height: 1px; background: StudioTheme.border; }
                Text { height: 18px; text: "USER PRESET"; color: StudioTheme.tertiary; font-size: 11px; }
                LineEdit { height: 30px; text <=> root.preset-name; placeholder-text: "Preset name"; }
                LineEdit { height: 30px; text <=> root.preset-path; placeholder-text: "Path to .synth.json"; }
                HorizontalLayout { height: 30px; spacing: 5px;
                    save-preset-button := Button { text: "Save preset"; enabled: root.is-synth; clicked => { root.save-synth-preset(root.track-id, root.instance-id, root.preset-path, root.preset-name); } }
                    load-preset-button := Button { text: "Load preset"; enabled: root.is-synth; clicked => { root.load-synth-preset(root.track-id, root.instance-id, root.preset-path); } }
                }
                Text { height: 28px; text: "Presets copy values into this track.\nNotes and track volume are retained."; color: StudioTheme.secondary; font-size: 10px; }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                visible: root.sound-tab && !root.project-tab && root.is-drums;
                x:0;y:0;width:parent.width - 8px;height:1100px;spacing:7px;
                drum-sound-label := Text {height:18px;text:"EDITOR SOUND  ·  " + root.track-name;color:StudioTheme.accent;overflow:elide;font-size:11px;}
                Text {height:18px;text:root.drum-kit-name;color:StudioTheme.secondary;overflow:elide;font-size:12px;}
                Text {height:18px;text:"GM subset · 16 pads · independent kit";color:StudioTheme.secondary;font-size:10px;}
                HorizontalLayout {height:root.velocity-control-height;spacing:4px;
                    Text {text:"Preview vel.";color:StudioTheme.text;vertical-alignment:center;font-size:11px;}
                    SpinBox {width:root.velocity-control-width;accessible-label:"Drum preview velocity";minimum:1;maximum:127;value<=>root.pad-preview-velocity;}
                }
                drum-focus := FocusScope {
                    height:216px;focus-lost(reason)=>{root.release-audition();}
                    for pad[index] in root.drum-pads : Rectangle {
                        x:(index - floor(index/4)*4)*(parent.width/4);y:floor(index/4)*54px;
                        width:parent.width/4 - 4px;height:50px;border-radius:4px;
                        background:pad-touch.pressed || root.pad-pulses[index] ? #315c4c : pad.filled ? StudioTheme.raised : StudioTheme.canvas;
                        border-width:root.pad-id==pad.id ? 2px : 1px;border-color:root.pad-id==pad.id ? StudioTheme.accent : StudioTheme.border;
                        Text {x:4px;y:4px;width:parent.width - 8px;height:27px;text:pad.name;wrap:word-wrap;overflow:elide;color:pad.filled ? StudioTheme.text : StudioTheme.tertiary;font-size:9px;}
                        Text {x:4px;y:34px;width:parent.width - 8px;height:12px;text:pad.filled ? (root.pad-mutes[index] ? "M · " : "")+pad.midi : "Empty · "+pad.midi;color:StudioTheme.secondary;font-size:8px;}
                        pad-touch := TouchArea {
                            accessible-role:button;accessible-label:pad.name+" · MIDI "+pad.midi;
                            pointer-event(event)=>{
                                if event.kind==PointerEventKind.down && event.button==PointerEventButton.left {drum-focus.focus();root.select-pad(pad.id);root.drum-pad-gate(pad.id,true);}
                                if event.kind==PointerEventKind.up {root.drum-pad-gate(pad.id,false);}
                                if event.kind==PointerEventKind.cancel {root.release-audition();}
                            }
                            moved=>{if self.pressed && (self.mouse-x<0px || self.mouse-x>=self.width || self.mouse-y<0px || self.mouse-y>=self.height){root.release-audition();}}
                            Tooltip {text:@markdown("\{pad.name} · MIDI \{pad.midi}");}
                        }
                    }
                }
                Text {height:18px;text:"SELECTED PAD · MIDI "+root.pad-midi;color:StudioTheme.accent;font-size:11px;}
                pad-name-edit := LineEdit {height:30px;text<=>root.pad-name;accepted=>{root.rename-pad(self.text);}}
                Button {height:28px;text:"Rename pad";clicked=>{root.rename-pad(pad-name-edit.text);}}
                HorizontalLayout {height:30px;spacing:4px;
                    Text {text:"MIDI";color:StudioTheme.text;vertical-alignment:center;}
                    pad-map-spin := SpinBox {minimum:0;maximum:127;value<=>root.pad-midi;width:88px;}
                    pad-map-button := Button {text:"Apply map";clicked=>{root.map-pad(pad-map-spin.value);}}
                }
                HorizontalLayout {height:30px;spacing:5px;
                    pad-mute-button := Button {text:"Mute";checked:root.pad-muted;accessible-checkable:true;accessible-checked:root.pad-muted;clicked=>{root.toggle-pad(3);}}
                    pad-mode-button := Button {text:root.pad-one-shot ? "One-shot" : "Gated";checked:root.pad-one-shot;accessible-checkable:true;accessible-checked:root.pad-one-shot;clicked=>{root.toggle-pad(4);}}
                }
                Text {height:18px;text:"Pad volume  "+round(root.pad-gain*100)+"%";color:StudioTheme.text;}
                pad-gain-slider := Slider {height:26px;minimum:0;maximum:4;value<=>root.pad-gain;changed(value)=>{root.pad-parameter(0,value);}released(value)=>{root.finish-mix();}}
                Text {height:18px;text:"Pad pan  "+round(root.pad-pan*100);color:StudioTheme.text;}
                pad-pan-slider := Slider {height:26px;minimum:-1;maximum:1;value<=>root.pad-pan;changed(value)=>{root.pad-parameter(1,value);}released(value)=>{root.finish-mix();}}
                HorizontalLayout {height:30px;
                    Text {text:"Tune · semitones";color:StudioTheme.text;vertical-alignment:center;font-size:11px;}
                    SpinBox {minimum:-24;maximum:24;width:88px;value<=>root.pad-tune;edited(value)=>{root.pad-parameter(2,value);root.finish-mix();}}
                }
                HorizontalLayout {height:30px;
                    Text {text:"Choke · 0 = none";color:StudioTheme.text;vertical-alignment:center;font-size:11px;}
                    SpinBox {minimum:0;maximum:16;width:88px;value<=>root.pad-choke;edited(value)=>{root.pad-parameter(5,value);root.finish-mix();}}
                }
                Text {height:38px;text:"Tune / mode / choke apply to new hits.\nHi-hats share choke group 1.\nTrack volume / pan: Track tab.";color:StudioTheme.secondary;font-size:10px;}
                Rectangle {height:1px;background:StudioTheme.border;}
                Text {height:32px;text:root.pad-filled ? root.pad-source : "Empty pad · import a WAV";color:StudioTheme.secondary;font-size:10px;wrap:word-wrap;overflow:elide;}
                LineEdit {height:30px;text<=>root.pad-import-path;placeholder-text:"Path to replacement WAV";}
                HorizontalLayout {height:30px;spacing:5px;
                    pad-import-button := Button {text:"Replace WAV";clicked=>{root.import-pad(root.pad-import-path);}}
                    pad-clear-button := Button {text:"Clear";enabled:root.pad-filled;clicked=>{root.clear-pad();}}
                }
                Text {height:48px;text:"One-shots finish after button release.\nFocus / track changes cancel previews.\nMapping and sample edits stop playback;\nUndo restores the previous pad.";color:StudioTheme.secondary;font-size:10px;}
                Button {height:30px;text:"Reset CC0 kit";clicked=>{root.use-drums(root.track-id);}}
                Text {height:28px;text:"VCSL · Versilian Studios · CC0 1.0\nTwelve sounds; four empty pads for import.";color:StudioTheme.tertiary;font-size:10px;}
                Rectangle {vertical-stretch:1;}
            }
            VerticalLayout {
                visible: root.project-tab;
                x: 0; y: 0; width: parent.width - 8px; height: 460px; spacing: 8px;
                Text { height: 18px; text: "PROJECT FOLDER"; color: StudioTheme.tertiary; font-size: 11px; }
                Text { height: 58px; text: root.project-path == "" ? "Choose a folder with Save as…" : root.project-path; wrap: char-wrap; color: StudioTheme.text; font-size: 11px; }
                HorizontalLayout { height: 30px;
                    Button { text: "Save"; clicked => { root.request-save(); } }
                    Button { text: "Save as…"; clicked => { root.show-save-as(); } }
                }
                Button { height: 30px; text: "Open project folder"; enabled: root.project-path != ""; clicked => { root.reveal-project(); } }
                Button { height: 30px; text: "New / Recent projects…"; enabled: !root.export-busy; clicked => { root.show-projects(); } }
                HorizontalLayout { height: 30px;
                    Text { text: "Tempo"; color: StudioTheme.text; vertical-alignment: center; }
                    TempoControl { value <=> root.bpm; edited(value) => { root.tempo(value); } }
                }
                Text { height: 18px; text: "WAV EXPORT"; color: StudioTheme.tertiary; font-size: 11px; }
                LineEdit { height: 30px; text <=> root.export-path; }
                Button { height: 30px; text: root.export-busy ? "Exporting…" : "Export PCM16 WAV"; enabled: !root.export-busy;
                    clicked => { root.export-audio(root.export-path); } }
                Text { height: 34px; text: "Export includes track mute / solo.\nPlayback continues independently."; color: StudioTheme.secondary; font-size: 11px; }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
    Rectangle {
        x: 0; y: root.height - 22px; width: root.width; height: 22px; background: StudioTheme.app;
        Text { x: 12px; y: 4px; height: 19px; width: parent.width - 218px;
            text: root.action-error != "" ? root.action-error : root.arrangement-limited ? "Preview limited to 256 clips; zoom in." : StudioTheme.focus-hint != "" ? StudioTheme.focus-hint : root.status;
            color: root.action-error != "" ? StudioTheme.error : StudioTheme.secondary; vertical-alignment: center; overflow: elide; font-size: 11px; }
        Rectangle { x: parent.width - 190px; y: 4px; width: 170px; height: 5px; background: StudioTheme.raised;
            Rectangle { x: 0; y: 0; width: parent.width * root.peak-left; height: parent.height; background: StudioTheme.accent; } }
        Rectangle { x: parent.width - 190px; y: 12px; width: 170px; height: 5px; background: StudioTheme.raised;
            Rectangle { x: 0; y: 0; width: parent.width * root.peak-right; height: parent.height; background: StudioTheme.accent; } }
    }
    if StudioTheme.focus-tooltip-visible && StudioTheme.focus-hint != "" && !root.home-visible : Rectangle {
        x: max(4px, min(root.width - self.width - 4px, StudioTheme.focus-tooltip-x));
        y: min(root.height - self.height - 24px, StudioTheme.focus-tooltip-y + 4px);
        width: max(100px, min(240px, StudioTheme.focus-hint.character-count * 7px + 16px)); height: 28px;
        background: StudioTheme.raised; border-width: 1px; border-color: #566470; border-radius: 4px;
        Text { x: 8px; width: parent.width - 16px; text: StudioTheme.focus-hint; color: StudioTheme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }
    // The initial hit target can disappear when a long timeline pan culls a
    // clip or row. A stable window-level target continues the same drag until
    // release, without retaining offscreen clip widgets or blocking normal input.
    if root.middle-pan-target != 0 : TouchArea {
        x:0; y:0; width:root.width; height:root.height;
        mouse-cursor: grabbing;
        pointer-event(event) => {
            if event.kind==PointerEventKind.move {root.move-middle-pan(self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);}
            if (event.kind==PointerEventKind.up && event.button==PointerEventButton.middle) || event.kind==PointerEventKind.cancel {root.end-middle-pan();}
        }
        changed has-hover => {if !self.has-hover {root.end-middle-pan();}}
    }
    Rectangle {
        visible: root.home-visible;
        x: 0; y: 0; width: parent.width; height: parent.height - 42px; background: StudioTheme.app;
        TouchArea { }
        VerticalLayout {
            x: (parent.width - 900px) / 2; y: 46px; width: 900px; height: parent.height - 82px; spacing: 18px;
            HorizontalLayout { height: 38px;
                Text { text: "OPENDAW"; color: StudioTheme.accent; font-size: 28px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Button { visible: root.has-project; text: "Back to project"; clicked => { root.home-visible = false; } }
            }
            Text { height: 32px; text: "Your next session starts here."; color: StudioTheme.text; font-size: 23px; }
            HorizontalLayout { spacing: 22px;
                Rectangle { width: 360px; background: StudioTheme.panel; border-radius: 10px;
                    VerticalLayout { padding: 22px; spacing: 12px;
                        Text { height: 28px; text: "New project"; color: StudioTheme.text; font-size: 20px; font-weight: 600; }
                        Text { height: 28px; text: "Start with an empty instrument track."; color: StudioTheme.secondary; font-size: 12px; }
                        Text { height: 18px; text: "PROJECT NAME"; color: StudioTheme.tertiary; font-size: 11px; }
                        LineEdit { height: 36px; text <=> root.new-name; placeholder-text: "My song"; }
                        Text { height: 18px; text: "SAVE IN"; color: StudioTheme.tertiary; font-size: 11px; }
                        LineEdit { height: 36px; text <=> root.new-parent; placeholder-text: "Choose a folder"; }
                        Button { height: 32px; text: "Choose folder…"; clicked => { root.browse-folder(0); } }
                        Text { height: 52px; text: "A new .opendaw folder will contain your\nproject and its audio samples."; color: StudioTheme.secondary; font-size: 12px; wrap: word-wrap; }
                        create-project-button := Button { height: 40px; text: "Create project"; enabled: root.new-name != "" && root.new-parent != "" && root.pending-actions == 0 && !root.export-busy;
                            clicked => { root.request-switch(1, root.new-parent, root.new-name); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: StudioTheme.canvas; border-radius: 10px;
                    VerticalLayout { padding: 22px; spacing: 12px;
                        HorizontalLayout { height: 32px;
                            Text { text: "Recent projects"; color: StudioTheme.text; font-size: 20px; font-weight: 600; }
                            Button { text: "Open project…"; enabled: !root.export-busy; clicked => { root.choose-open-project(); } }
                        }
                        Text { visible: root.recent-projects.length == 0; height: root.recent-projects.length == 0 ? 68px : 0px; text: "No recent projects yet.\nCreate a project or open an existing .opendaw folder."; color: StudioTheme.secondary; font-size: 12px; wrap: word-wrap; }
                        recent-scroll := ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout { spacing: 8px;
                                for project in root.recent-projects : Rectangle {
                                    height: 72px; background: StudioTheme.raised; border-radius: 6px;
                                    VerticalLayout { padding: 10px; spacing: 5px;
                                        Text { text: project.name + (project.available ? "" : " · unavailable"); color: project.available ? StudioTheme.text : #b6a18d; font-size: 14px; overflow: elide; }
                                        Text { text: project.path; color: StudioTheme.tertiary; font-size: 10px; overflow: elide; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.request-switch(0, project.path, ""); }
                                        Tooltip { text: @markdown("\{project.path}"); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.save-as-visible : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 560px; height: 360px; background: StudioTheme.raised; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 12px;
                Text { text: "Save project as…"; color: StudioTheme.text; font-size: 23px; }
                Text { text: "Create a portable copy in a new .opendaw folder."; color: StudioTheme.secondary; }
                LineEdit { height: 34px; text <=> root.save-as-name; placeholder-text: "Project folder name"; }
                LineEdit { height: 34px; text <=> root.save-as-parent; placeholder-text: "Save in"; }
                Button { height: 30px; text: "Choose folder…"; clicked => { root.browse-folder(1); } }
                Text { height: 40px; text: root.action-error; color: StudioTheme.error; wrap: word-wrap; font-size: 11px; }
                HorizontalLayout { height: 34px;
                    Button { text: "Cancel"; clicked => { root.save-as-visible = false; } }
                    Button { text: "Save copy"; enabled: root.pending-actions == 0; clicked => { root.save-project-as(root.save-as-parent, root.save-as-name); } }
                }
            }
        }
    }
    Rectangle {
        visible: root.confirm-switch;
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 580px; height: 250px; background: StudioTheme.raised; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: "Save changes before switching?"; color: StudioTheme.text; font-size: 23px; }
                Text { text: "Choose what to do with edits to " + root.project-name + "."; color: StudioTheme.secondary; wrap: word-wrap; }
                Text { height: 40px; text: root.action-error; color: StudioTheme.error; wrap: word-wrap; font-size: 11px; }
                HorizontalLayout { height: 34px;
                    Button { text: "Cancel"; clicked => { root.confirm-switch = false; } }
                    switch-discard-button := Button { text: "Discard and continue"; enabled: root.pending-actions == 0; clicked => { root.switch-project(root.pending-project-kind, root.pending-project-path, root.pending-project-name, 2); } }
                    switch-save-button := Button { text: "Save and continue"; enabled: root.pending-actions == 0; clicked => { root.switch-project(root.pending-project-kind, root.pending-project-path, root.pending-project-name, 1); } }
                }
            }
        }
    }
    if root.about-visible : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 420px; height: 320px; background: Palette.background; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: "OpenDAW 0.2.0"; color: Palette.foreground; font-size: 23px; }
                Text { text: "Music creation with a C++ audio engine and Slint interface."; color: Palette.foreground; wrap: word-wrap; }
                AboutSlint { }
                Button { text: "Close"; clicked => { root.about-visible = false; } }
            }
        }
    }
    if root.confirm-close : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000b0;
        TouchArea { }
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 480px; height: 190px; background: StudioTheme.raised; border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: "Close OpenDAW?"; color: StudioTheme.text; font-size: 23px; }
                Text { text: "Save your edits before closing. Unsaved changes will be lost."; color: StudioTheme.secondary; wrap: word-wrap; }
                HorizontalLayout {
                    Button { text: "Keep editing"; clicked => { root.confirm-close = false; } }
                    Button { text: "Save"; clicked => { root.request-save(); root.confirm-close = false; } }
                    Button { text: "Discard and close"; clicked => { root.exit-confirmed(); } }
                }
            }
        }
    }
}
